# Juliet's ~/.config/local/.env template. juliet-bootstrap copies this to
# ~/.config/local/.env when that file doesn't exist, and otherwise appends only
# the keys it's missing. Fill values in ~/.config/local/.env, never here: this
# file is committed. Format: NAME=value, no quotes, comments in column 1.

# Your Juliet extension: a git URL or a local path (see EXTENSIONS.md).
JULIET_EXTENSION=

# Tokens read by tools Juliet configures (leave blank if unused).
SENTRY_ACCESS_TOKEN=
LINEAR_API_KEY=
GITHUB_PAT=
