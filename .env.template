# Juliet's ~/.config/local/.env template. juliet-bootstrap copies this to
# ~/.config/local/.env when that file doesn't exist, and otherwise appends only
# the keys it's missing. Fill values in ~/.config/local/.env, never here: this
# file is committed. Format: NAME=value, no quotes, comments in column 1.

# Your Juliet extensions: git URLs or local paths, space-separated and quoted
# when there are several, applied in order (see EXTENSIONS.md).
JULIET_EXTENSION=

# Initials prefixed by `commit -s` (e.g. KH).
GIT_INITIALS=

# Terminal apps for Hammerspoon's ctrl+space toggle, by bundle ID, comma-
# separated, first installed one wins. Defaults to Rex, cmux, Ghostty, kitty,
# then iTerm2 when unset. Left commented so an extension's .env.template can
# seed it, e.g.
# JULIET_TERMINALS=com.superlogical.rex,com.cmuxterm.app,com.mitchellh.ghostty,net.kovidgoyal.kitty,com.googlecode.iterm2

# Tokens read by tools Juliet configures (leave blank if unused).
LINEAR_API_KEY=
