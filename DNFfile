# Juliet DNFfile - Fedora packages
# Format:
#   copr <user/repo>  - enables COPR repository
#   <package>         - installs package

# COPR Repositories
copr atim/starship
copr scottames/ghostty
copr solopasha/hyprland
copr phracek/PyCharm
copr zhangyi6324/noctalia-shell
# neovide has no official Fedora package; agraven/neovide is abandoned (empty
# f44 repo) — bijumon/neovide-release tracks upstream releases with f44 builds
copr bijumon/neovide-release
copr pgdev/deno
# keyd (key remapper) isn't in Fedora's repos; alternateved/keyd is the COPR the
# upstream keyd README points to and it ships f44 builds
copr alternateved/keyd

