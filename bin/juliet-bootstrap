#! /bin/bash

source ~/.config/Juliet/_util.bash

# Abort the whole script when the user hits Ctrl+C, instead of letting
# individual prompts treat it as "No" and falling through to the next step.
on-interrupt() {
  echo
  warn "Cancelled."
  exit 130
}
trap on-interrupt INT

# gum confirm exits 0 for yes, 1 for no, 130 for Ctrl+C. Treat anything other
# than yes/no as a cancellation of the whole bootstrap.
gum-confirm() {
  gum confirm "$@"
  local rc=$?
  if [[ $rc -ne 0 && $rc -ne 1 ]]; then
    on-interrupt
  fi
  return $rc
}

# Non-fatal error handling: an optional step that fails shouldn't abort the
# whole bootstrap. Guard such steps with
#   <step> || bootstrap_error "<summary>" ["<detail line>"...]
# The summary is logged immediately (via error()) with any detail lines —
# remedy commands, paths — indented under it, recorded, and the whole entry is
# re-reported by print-bootstrap-summary at the end, while bootstrap keeps
# going. Keep each line short; put commands on their own detail line instead
# of inlining them in the summary.
BOOTSTRAP_ERRORS=()

bootstrap_error() {
  local summary="$1"
  shift
  error "$summary"
  local line
  for line in "$@"; do
    printf "      %s\n" "$line" >&2
  done
  BOOTSTRAP_ERRORS+=("$(printf '%s\n' "$summary" "$@")")
}

print-bootstrap-summary() {
  if [[ ${#BOOTSTRAP_ERRORS[@]} -eq 0 ]]; then
    log "✅ Done!"
    return 0
  fi
  echo
  warn "Bootstrap finished with ${#BOOTSTRAP_ERRORS[@]} error(s):"
  local entry line printed
  for entry in "${BOOTSTRAP_ERRORS[@]}"; do
    printed=""
    while IFS= read -r line; do
      if [[ -z "$printed" ]]; then
        error "  • $line"
        printed=1
      else
        printf "        %s\n" "$line" >&2
      fi
    done <<< "$entry"
  done
  return 1
}

# Global flags
YES_ALL="false"
NO_ALL="false"
ENABLED_STEPS=()
SKIPPED_STEPS=()
SSH_EMAIL=""

show-help() {
  cat << 'EOF'
Usage: juliet-bootstrap [OPTIONS]

Options:
  -y, --yes              Accept all prompts
  -n, --no               Decline all prompts
  --enable=STEPS         Only run these steps (comma-separated)
  --skip=STEPS           Skip these steps (comma-separated)
  --ssh-email=EMAIL      Email for SSH key generation
  -h, --help             Show this help message

Steps: packages (includes flatpak), fonts, dev, shell, security, desktop, claude, opencode

Examples:
  juliet-bootstrap -y                        # Accept all prompts
  juliet-bootstrap -y --skip=packages        # All except packages
  juliet-bootstrap --enable=shell,security   # Only shell and security
  juliet-bootstrap --enable=security --ssh-email=test@example.com

Environment Variables:
  JULIET_BOOTSTRAP_ARGS  Default arguments when no CLI args provided
                         Any CLI argument disables the env var

Environment variable example:
  export JULIET_BOOTSTRAP_ARGS="-y --skip=packages"
  juliet-bootstrap              # Uses env var
  juliet-bootstrap --no         # Ignores env var, uses only CLI args
EOF
}

# Parse environment variable arguments only if no CLI args provided
if [[ $# -eq 0 && -n "${JULIET_BOOTSTRAP_ARGS:-}" ]]; then
  eval "set -- $JULIET_BOOTSTRAP_ARGS"
fi

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -y|--yes)
      YES_ALL="true"
      shift
      ;;
    -n|--no)
      NO_ALL="true"
      shift
      ;;
    --enable=*)
      IFS=',' read -ra ENABLED_STEPS <<< "${1#*=}"
      shift
      ;;
    --skip=*)
      IFS=',' read -ra SKIPPED_STEPS <<< "${1#*=}"
      shift
      ;;
    --ssh-email=*)
      SSH_EMAIL="${1#*=}"
      shift
      ;;
    -h|--help)
      show-help
      exit 0
      ;;
    *)
      warn "Unknown option: $1"
      show-help
      exit 1
      ;;
  esac
done

# Check if a step should run based on --enable and --skip flags
should-run-step() {
  local step="$1"

  # If --enable was used, only run if step is in the list
  if [[ ${#ENABLED_STEPS[@]} -gt 0 ]]; then
    [[ " ${ENABLED_STEPS[*]} " =~ " $step " ]] && return 0 || return 1
  fi

  # If --skip was used, skip if step is in the list
  if [[ " ${SKIPPED_STEPS[*]} " =~ " $step " ]]; then
    return 1
  fi

  return 0
}

# Determine whether to prompt or auto-answer based on flags
should-confirm() {
  local step="$1"
  local prompt="$2"

  # Step was explicitly enabled via --enable
  if [[ ${#ENABLED_STEPS[@]} -gt 0 ]] && [[ " ${ENABLED_STEPS[*]} " =~ " $step " ]]; then
    return 0
  fi

  # Global yes/no flags
  [[ "$YES_ALL" == "true" ]] && return 0
  [[ "$NO_ALL" == "true" ]] && return 1

  # Interactive prompt
  gum-confirm "$prompt"
}

# Category-level confirmation (combines should-run-step + should-confirm)
confirm-category() {
  local category="$1"
  local description="$2"

  if ! should-run-step "$category"; then
    skip "Skipping $category step(s) (filtered)"
    return 1
  fi

  # Explicitly enabled via --enable: run without prompting (matches should-confirm)
  if [[ ${#ENABLED_STEPS[@]} -gt 0 ]] && [[ " ${ENABLED_STEPS[*]} " =~ " $category " ]]; then
    return 0
  fi

  [[ "$YES_ALL" == "true" ]] && return 0

  if [[ "$NO_ALL" == "true" ]]; then
    skip "Skipping $category step(s)"
    return 1
  fi

  if ! gum-confirm "$description"; then
    skip "Skipping $category step(s)"
    return 1
  fi

  return 0
}

# OS Detection
is-fedora() {
  [ -f /etc/fedora-release ]
}

is-macos() {
  [[ "$OSTYPE" == "darwin"* ]]
}

setup-git() {
  substep "Setting up git..."
  mkdir -p ~/.config/local
  [[ ! -f ~/.config/local/gitconfig ]] && cp ~/.config/Juliet/.gitconfig__local ~/.config/local/gitconfig
}

update-juliet() {
  substep "Updating Juliet repository..."
  WORKDIR="$HOME/.config/Juliet"
  if [ -d "$WORKDIR" ]; then
    cd "$WORKDIR"

    if ! git diff --quiet; then
      warn "Warning: There are unstaged changes in ~/.config/Juliet. Skipping updating Juliet."
      cd - > /dev/null
      return
    fi


    DEFAULT_BRANCH=$(git remote show origin | grep 'HEAD branch' | cut -d' ' -f5)

    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    if [ "$CURRENT_BRANCH" = "$DEFAULT_BRANCH" ]; then
      git pull
    else
      warn "Warning: ~/.config/Juliet is not on the default branch. Current branch: $CURRENT_BRANCH"
      return
    fi

    cd - > /dev/null
  else
    error "Juliet directory not found at $WORKDIR"
  fi
}


# Install Homebrew and wire it into PATH if it isn't already available.
ensure-brew() {
  if command -v brew &> /dev/null; then
    return
  fi

  rlog "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install.sh)"

  # Set up brew path based on OS
  if [[ -f /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    # Linux
    BREW_SHELLENV='eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"'
    if ! grep -q "linuxbrew" "$HOME/.bashrc" 2>/dev/null; then
      echo "$BREW_SHELLENV" >> "$HOME/.bashrc"
    fi
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  else
    # macOS
    echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >> "$HOME/.zprofile"
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi
}

# Install the tools bootstrap itself relies on before it uses them: stow (for
# symlinking dotfiles in core setup) and gum (for the confirmation prompts).
# The full package steps run later and are idempotent, so this early install is
# just to satisfy the ordering dependency.
ensure-bootstrap-deps() {
  substep "Checking bootstrap prerequisites (stow, gum)..."
  if is-macos; then
    ensure-brew
    for tool in stow gum; do
      command -v "$tool" &> /dev/null && continue
      rlog "Installing $tool via brew..."
      brew install "$tool"
    done
  elif is-fedora; then
    for tool in stow gum; do
      command -v "$tool" &> /dev/null && continue
      rlog "Installing $tool via dnf..."
      sudo dnf install -y "$tool"
    done
  fi
}

setup-brew() {
  ensure-brew

  if ! command -v gum &> /dev/null; then
    brew install gum
  fi

  rlog "Running brew bundle..."
  brew bundle --file ~/.config/Juliet/Brewfile \
    || bootstrap_error "brew bundle reported failures — check the output above." \
      "Then re-run: juliet-bootstrap --enable=packages"
}

setup-cargo() {
  substep "Checking cargo..."
  if ! command -v cargo &> /dev/null; then
    rlog "Installing Rust via rustup-init..."
    rustup-init
  fi
}

# A DNFfile entry may be satisfied by a differently-named package: Fedora 44
# ships node only as versioned streams (nodejs -> nodejs22 via a virtual
# provide), kubernetes-client -> kubernetes1.36-client, and dnf resolves
# deno -> deno-bin through /usr/bin/deno binary provides. Checking only
# `rpm -q <name>` misses all of these, so those entries got "retried"
# (and reported failed on any transient dnf error) on every single run.
dnf-satisfied() {
  rpm -q "$1" &> /dev/null && return 0
  rpm -q --whatprovides "$1" &> /dev/null && return 0
  # Binary/file provides need dnf's resolver; --assumeno exits 0 only when
  # the spec is already satisfied. The cache is fresh from the transaction
  # that just ran, so --cacheonly keeps this fast and offline.
  dnf --cacheonly install --assumeno "$1" &> /dev/null
}

setup-dnf() {
  substep "Setting up DNF packages..."

  if ! command -v gum &> /dev/null; then
    sudo dnf install -y gum
  fi

  DNFFILE="$HOME/.config/Juliet/DNFfile"
  if [[ ! -f "$DNFFILE" ]]; then
    warn "DNFfile not found at $DNFFILE"
    return
  fi

  # Enable RPM Fusion (free + nonfree) first: some DNFfile packages (e.g.
  # steam) only exist there and would otherwise be silently skipped by
  # --skip-unavailable.
  if ! rpm -q rpmfusion-free-release &> /dev/null || ! rpm -q rpmfusion-nonfree-release &> /dev/null; then
    rlog "Enabling RPM Fusion repositories..."
    sudo dnf install -y \
      "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
      "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm"
  fi

  # Enable COPR repos first
  while IFS= read -r line || [[ -n "$line" ]]; do
    # Skip empty lines and comments
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    # Handle COPR repos
    if [[ "$line" =~ ^copr[[:space:]]+ ]]; then
      repo="${line#copr }"
      if ! dnf copr list 2>/dev/null | grep -q "$repo"; then
        rlog "Enabling COPR: $repo"
        sudo dnf copr enable -y "$repo"
      fi
    fi
  done < "$DNFFILE"

  # Collect packages
  packages=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    # Skip empty lines, comments, and copr lines
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# || "$line" =~ ^copr[[:space:]]+ ]] && continue
    packages+=("$line")
  done < "$DNFFILE"

  # Install packages
  if [[ ${#packages[@]} -gt 0 ]]; then
    rlog "Installing ${#packages[@]} DNF packages..."
    # --skip-unavailable/--skip-broken keep one bad package (e.g. steam
    # without RPM Fusion) from aborting the whole transaction.
    sudo dnf install -y --skip-unavailable --skip-broken "${packages[@]}"

    # Retry anything still missing individually so each failure surfaces its
    # own error instead of being silently skipped.
    failed=()
    for pkg in "${packages[@]}"; do
      dnf-satisfied "$pkg" && continue
      substep "Retrying $pkg individually..."
      sudo dnf install -y "$pkg" || failed+=("$pkg")
    done
    if [[ ${#failed[@]} -gt 0 ]]; then
      bootstrap_error "Failed to install DNF packages: ${failed[*]}" \
        "Install them manually, then re-run: juliet-bootstrap --enable=packages"
    fi
  fi
}

setup-flatpak() {
  substep "Setting up Flatpak packages..."

  FLATPAKFILE="$HOME/.config/Juliet/Flatpakfile"
  if [[ ! -f "$FLATPAKFILE" ]]; then
    warn "Flatpakfile not found at $FLATPAKFILE"
    return
  fi

  # Add remotes first
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    if [[ "$line" =~ ^remote[[:space:]]+ ]]; then
      read -r _ name url <<< "$line"
      substep "Adding Flatpak remote: $name"
      flatpak remote-add --if-not-exists "$name" "$url"
    fi
  done < "$FLATPAKFILE"

  # Install apps
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# || "$line" =~ ^remote[[:space:]]+ ]] && continue
    spin "Installing Flatpak: $line..." flatpak install -y flathub "$line" \
      || bootstrap_error "Failed to install Flatpak $line" \
        "Retry manually: flatpak install flathub $line"
  done < "$FLATPAKFILE"

  # Flatpak bind-mounts host font *files* into every sandbox, but not the host's
  # user fontconfig *config*. Without this, symlinked/config/fontconfig/fonts.conf
  # is invisible inside the sandbox and generic families (sans-serif, monospace)
  # fall back to the runtime's DejaVu instead of Iosevka Nerd Font Mono. Applies
  # globally so future Flatpaks inherit it. User-level; no root needed.
  substep "Granting Flatpaks read access to user fontconfig..."
  flatpak override --user --filesystem=xdg-config/fontconfig:ro \
    || warn "Could not set Flatpak fontconfig override — Flatpak apps will use DejaVu for generic families."
}

symlink-dotfiles() {
  substep "Symlinking dotfiles..."
  mkdir ~/.claude 2>/dev/null || true
  # Keep ~/.config/opencode a real dir so stow file-links only our tracked
  # content (plugins/cmux.js) into it; opencode writes node_modules/
  # package.json (its own bun-managed plugin deps) at that root, which must
  # stay out of the repo. opencode.json and tui.json are deliberately NOT
  # stowed — opencode/dev-env both write config files, and a write through a
  # symlink would dirty this repo (see setup-opencode for the layering).
  mkdir -p ~/.config/opencode 2>/dev/null || true
  stow --target=$HOME --dir=$HOME/.config/Juliet/symlinked home \
    || bootstrap_error "stow home failed — conflicts with existing real files (see above)." \
      "Resolve the conflicts, then re-run: juliet-bootstrap"
  stow --target=$HOME/.config --dir=$HOME/.config/Juliet/symlinked config \
    || bootstrap_error "stow config failed — conflicts with existing real files (see above)." \
      "Resolve the conflicts, then re-run: juliet-bootstrap"
  # local-state only exists when something needs ~/.local/state files
  if [[ -d $HOME/.config/Juliet/symlinked/local-state ]]; then
    mkdir -p "$HOME/.local/state"
    stow --target=$HOME/.local/state --dir=$HOME/.config/Juliet/symlinked local-state
  fi
}

setup-ssh() {
  substep "Setting up SSH keys..."

  if [[ ! -d $HOME/.ssh ]]; then
    mkdir $HOME/.ssh
    chmod 700 $HOME/.ssh
  fi

  # Three keys: a general-purpose one, plus dedicated GitHub auth and signing
  # keys. The tracked gitconfig signs commits over SSH, and the tracked
  # ~/.config/ssh/github.conf pins the auth key for github.com.
  local missing=()
  local key
  for key in id_ed25519 github_auth github_signing; do
    [[ -f $HOME/.ssh/$key ]] || missing+=("$key")
  done

  local email="${SSH_EMAIL:-}"
  if [[ ${#missing[@]} -gt 0 && -z "$email" ]]; then
    email=$(gum input --prompt "What is your email for your ssh keys? " --placeholder "your_email@example.com")
    [[ $? -ne 0 || -z "$email" ]] && on-interrupt
  fi

  for key in "${missing[@]}"; do
    local comment="$email"
    case "$key" in
      github_auth) comment="$email (github auth)" ;;
      github_signing) comment="$email (github signing)" ;;
    esac
    ssh-keygen -t ed25519 -C "$comment" -f "$HOME/.ssh/$key"
  done

  # allowed_signers maps git author emails to the signing key so git can
  # verify SSH-signed commits locally (git log --show-signature). The tracked
  # gitconfig points gpg.ssh.allowedSignersFile here.
  local signers="$HOME/.ssh/allowed_signers"
  local signing_pub
  signing_pub=$(cut -d' ' -f1-2 "$HOME/.ssh/github_signing.pub")
  local git_email
  git_email=$(git config user.email 2>/dev/null || true)
  for signer_email in "$git_email" "$email"; do
    [[ -z "$signer_email" ]] && continue
    if ! grep -qsF "$signer_email $signing_pub" "$signers"; then
      echo "$signer_email $signing_pub" >> "$signers"
    fi
  done

  # ~/.ssh can't be stowed (generated keys would land inside the repo), so the
  # tracked GitHub host config lives at ~/.config/ssh/github.conf and gets
  # wired in with an Include at the top of ~/.ssh/config.
  local sshconf="$HOME/.ssh/config"
  local include_line="Include ~/.config/ssh/github.conf"
  if ! grep -qsxF "$include_line" "$sshconf"; then
    substep "Wiring tracked GitHub ssh config into ~/.ssh/config..."
    {
      echo "$include_line"
      [[ -f "$sshconf" ]] && cat "$sshconf"
    } > "$sshconf.juliet-tmp"
    mv "$sshconf.juliet-tmp" "$sshconf"
    chmod 600 "$sshconf"
  fi

  # Upload freshly generated GitHub keys via gh when possible. gh needs the
  # admin:public_key / admin:ssh_signing_key scopes, which the default login
  # doesn't grant — fall back to instructions if the add is rejected.
  if [[ ${#missing[@]} -gt 0 ]]; then
    local uploaded=true
    if command -v gh &> /dev/null && gh auth status &> /dev/null; then
      for key in "${missing[@]}"; do
        case "$key" in
          github_auth)
            gh ssh-key add "$HOME/.ssh/github_auth.pub" --type authentication --title "$(hostname) auth" || uploaded=false
            ;;
          github_signing)
            gh ssh-key add "$HOME/.ssh/github_signing.pub" --type signing --title "$(hostname) signing" || uploaded=false
            ;;
        esac
      done
    else
      uploaded=false
    fi
    if [[ "$uploaded" == "false" ]]; then
      bootstrap_error "Couldn't upload new SSH keys to GitHub automatically. To fix:" \
        "gh auth refresh -h github.com -s admin:public_key -s admin:ssh_signing_key" \
        "gh ssh-key add ~/.ssh/github_auth.pub --type authentication" \
        "gh ssh-key add ~/.ssh/github_signing.pub --type signing"
    fi
  fi
}

setup-fzf() {
  substep "Checking fzf..."
  if ! command -v fzf &> /dev/null; then
    rlog "Installing fzf..."
    /opt/homebrew/opt/fzf/install
  fi
}

setup-tmux-plugins() {
  # tpm (tmux plugin manager) bootstraps the plugins declared in the tracked
  # .tmux.conf; nothing installs it besides this clone.
  substep "Checking tpm (tmux plugin manager)..."
  if [[ ! -d "$HOME/.tmux/plugins/tpm" ]]; then
    spin "Installing tpm..." git clone --depth=1 https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm" \
      || bootstrap_error "Failed to clone tpm" \
        "Retry manually: git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm"
  fi
}

setup-fish() {
  mkdir -p ~/.config/fish

  FISH_PATH="$(command -v fish)"
  if [[ -z "$FISH_PATH" ]]; then
    warn "fish not found, skipping fish setup"
    return
  fi
  substep "Setting up fish..."

  if ! grep -q "$FISH_PATH" /etc/shells 2>/dev/null; then
    substep "Adding $FISH_PATH to /etc/shells..."
    sudo bash -c "echo '$FISH_PATH' >> /etc/shells"
  fi

  if [[ "$SHELL" != "$FISH_PATH" ]]; then
    substep "Setting fish to default shell..."
    chsh -s "$FISH_PATH" "$(whoami)"
  else
    skip "fish is already the default shell — skipping"
  fi
}

setup-gpg() {
  if [[ ! -d $HOME/.gnupg ]]; then
    substep "Setting up GPG..."
    mkdir ~/.gnupg
    touch ~/.gnupg/gpg-agent.conf
    echo "pinentry-program /usr/local/bin/pinentry-mac" >> ~/.gnupg/gpg-agent.conf
  fi
}

setup-cyberduck() {
  # macOS-only. Cyberduck offers every identity in the SSH agent, which trips
  # strict servers' MaxAuthTries (and fail2ban) before the right key is tried.
  # Tell it to ignore the agent and use only the key set per-bookmark instead.
  if ! is-macos; then
    return
  fi

  if [[ ! -d "/Applications/Cyberduck.app" && ! -d "$HOME/Applications/Cyberduck.app" ]]; then
    return
  fi

  substep "Configuring Cyberduck (ignore SSH agent, use per-bookmark key)..."
  defaults write ch.sudo.cyberduck ssh.authentication.agent.enable -bool false
}

setup-rust() {
  substep "Checking Rust tools (stylua, silicon, tabiew)..."
  if ! command -v stylua &> /dev/null; then
    spin "Installing stylua (cargo)..." cargo install stylua \
      || bootstrap_error "Failed to install stylua — run 'cargo install stylua' manually."
  fi

  if is-macos && ! command -v silicon &> /dev/null; then
    spin "Installing silicon (cargo)..." cargo install silicon \
      || bootstrap_error "Failed to install silicon — run 'cargo install silicon' manually."
  fi

  # tabiew (tw, used by the cq alias); macOS gets it from the Brewfile
  if is-fedora && ! command -v tw &> /dev/null; then
    spin "Installing tabiew (cargo)..." cargo install tabiew \
      || bootstrap_error "Failed to install tabiew — run 'cargo install tabiew' manually."
  fi
}

setup-python() {
  substep "Checking Python tools (poetry, sqlfluff, pipenv)..."
  if ! command -v poetry &> /dev/null; then
    spin "Installing poetry..." sh -c 'curl -sSL https://install.python-poetry.org | python3 -' \
      || bootstrap_error "Failed to install poetry" \
        "Retry manually: curl -sSL https://install.python-poetry.org | python3 -"
  fi

  # sqlfluff (neoformat's SQL formatter) has no Fedora dnf package; macOS gets
  # it from the Brewfile
  if is-fedora && ! command -v sqlfluff &> /dev/null; then
    spin "Installing sqlfluff (pip)..." pip install --user sqlfluff \
      || bootstrap_error "Failed to install sqlfluff — run 'pip install --user sqlfluff' manually."
  fi

  # pipenv (the pv alias) was dropped from Fedora's repos entirely; macOS gets
  # it from the Brewfile
  if is-fedora && ! command -v pipenv &> /dev/null; then
    spin "Installing pipenv (pip)..." pip install --user pipenv \
      || bootstrap_error "Failed to install pipenv — run 'pip install --user pipenv' manually."
  fi
}

setup-node-tools() {
  substep "Checking Node tools (prettier, eslint)..."
  # prettier/eslint (neoformat/nvim-lint) have no Fedora dnf packages; macOS
  # gets them from the Brewfile
  if is-fedora; then
    for tool in prettier eslint; do
      if ! command -v "$tool" &> /dev/null; then
        rlog "Installing $tool via npm..."
        sudo npm install -g "$tool" \
          || bootstrap_error "Failed to install $tool — run 'sudo npm install -g $tool' manually."
      fi
    done
  fi
}

setup-nodenv() {
  # macOS gets nodenv from the Brewfile; Fedora has no dnf package, so use the
  # official installer (clones nodenv + node-build into ~/.nodenv).
  substep "Checking nodenv..."
  if command -v nodenv &> /dev/null || [[ -d "$HOME/.nodenv/bin" ]]; then
    return
  fi
  spin "Installing nodenv..." sh -c 'curl -fsSL https://github.com/nodenv/nodenv-installer/raw/HEAD/bin/nodenv-installer | bash' \
    || bootstrap_error "Failed to install nodenv — see https://github.com/nodenv/nodenv-installer."
}

setup-sddm() {
  if ! is-fedora; then
    return
  fi

  if ! command -v sddm &> /dev/null; then
    return
  fi

  # Make sddm the active display manager. Fedora's KDE spin installs
  # plasma-login-manager (plasmalogin.service) and enables it; this machine
  # runs niri, so sddm takes over as the greeter. display-manager.service is a
  # symlink to whichever DM is enabled, so enabling sddm repoints it.
  # This must happen BEFORE setup-deplasma removes plasma-login-manager,
  # otherwise the box is left with no way to log in graphically.
  if [[ "$(basename "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)" 2>/dev/null)" != "sddm.service" ]]; then
    substep "Making sddm the display manager..."
    if systemctl list-unit-files plasmalogin.service &> /dev/null; then
      sudo systemctl disable plasmalogin.service &> /dev/null || true
    fi
    sudo systemctl enable sddm.service \
      || bootstrap_error "Failed to enable sddm.service" \
        "Enable it manually before rebooting: sudo systemctl enable sddm.service"
  fi

  substep "Setting up SDDM theme..."

  THEME_SRC="$HOME/.config/Juliet/etc/sddm-themes/juliet"
  THEME_DEST="/usr/share/sddm/themes/juliet"

  if [[ ! -d "$THEME_SRC" ]]; then
    return
  fi

  # Always copy/update theme to system directory
  substep "Installing Juliet SDDM theme..."
  sudo rm -rf "$THEME_DEST"
  sudo cp -r "$THEME_SRC" "$THEME_DEST"
  # The theme renders solid black by default, matching the hyprlock lock
  # screen, so this wallpaper is unused until theme.conf sets
  # `background=background.png`. Copied anyway so making that switch is a
  # one-word edit rather than a hunt for the file.
  sudo cp "$HOME/.config/Juliet/etc/wallpaper/my-neighbor-totoro-sunflowers.png" "$THEME_DEST/background.png"
  sudo chmod -R 755 "$THEME_DEST"
  sudo find "$THEME_DEST" -type f -exec chmod 644 {} \;

  # Select the theme. Written whenever the content differs rather than only when
  # the file is absent: a create-once guard can't converge if the file drifts
  # (hand-edited, or left over from an earlier theme name), which would leave the
  # theme installed but not actually selected.
  SDDM_CONF="/etc/sddm.conf.d/juliet.conf"
  local want_conf
  want_conf=$'[Theme]\nCurrent=juliet'
  if [[ "$(cat "$SDDM_CONF" 2>/dev/null)" != "$want_conf" ]]; then
    substep "Configuring SDDM to use the Juliet theme..."
    sudo install -d -m 755 /etc/sddm.conf.d \
      || bootstrap_error "Failed to create /etc/sddm.conf.d"
    printf '%s\n' "$want_conf" | sudo tee "$SDDM_CONF" > /dev/null \
      || bootstrap_error "Failed to write $SDDM_CONF" \
        "Set it manually: printf '[Theme]\\nCurrent=juliet\\n' | sudo tee $SDDM_CONF"
  fi
}

# keyd gives the Super key (leftmeta) a dual role: hold = the Mod modifier for
# niri, tap = F13 (bound to toggle the noctalia Control Center). keyd is a root
# daemon that reads /etc/keyd, so its config can't be a stow symlink in $HOME —
# copy the tracked config in and (re)load the service instead.
setup-keyd() {
  if ! is-fedora; then
    return
  fi

  # keyd comes from the DNFfile (packages step); skip cleanly if it isn't here.
  if ! command -v keyd &> /dev/null; then
    return
  fi
  substep "Setting up keyd (dual-role Super: hold=Mod, tap=noctalia menu)..."

  local src="$HOME/.config/Juliet/etc/keyd/default.conf"
  if [[ ! -f "$src" ]]; then
    return
  fi

  # install -D creates /etc/keyd if missing and sets 0644 in one step.
  sudo install -Dm644 "$src" /etc/keyd/default.conf \
    || bootstrap_error "Failed to install /etc/keyd/default.conf" \
      "Copy it manually: sudo install -Dm644 $src /etc/keyd/default.conf"
  sudo systemctl enable --now keyd \
    || bootstrap_error "Failed to enable the keyd service" \
      "Enable it manually: sudo systemctl enable --now keyd"
  # Re-runs: pick up config changes without a restart (no-op on first enable).
  sudo keyd reload &> /dev/null || true
}

# Plasma components that are dead weight — or actively harmful — on a machine
# running niri. This box was installed from the Fedora KDE spin, so it carries
# a full Plasma stack it never uses.
#
# The motivating failure: drkonqi (Plasma's crash handler) segfaults outside a
# Plasma session, and systemd-coredump re-invokes it on every crash, forming a
# feedback loop. Left alone it produced 106,222 coredumps / 4.1GB and pinned
# the CPU package at 100°C for ten days (2026-07-15 → 2026-07-25).
#
# SCOPE IS DELIBERATELY LIMITED. plasma-desktop is a dnf *protected* package
# (/etc/dnf/protected.d/plasma-desktop.conf, owned by
# fedora-release-identity-kde-desktop) and it transitively pins
# plasma-workspace, plasma-workspace-libs, plasma-integration,
# plasma-systemsettings, plasma-activities{,-stats}, plasma-keyboard,
# plasma-breeze, plasma-lookandfeel-fedora, polkit-kde and
# xdg-desktop-portal-kde. Removing any of those first requires swapping the
# release identity (`dnf swap fedora-release-identity-kde-desktop
# fedora-release-identity-basic`), which rewrites /usr/lib/os-release and the
# systemd presets. That's a bigger, upgrade-path-affecting change and is
# deliberately NOT done here — the crash loop doesn't need it.
#
# plasma-integration-qt5 is excluded for a different reason: it drags the
# entire Qt5 stack out with it, which would take vlc (a DNFfile package) along.
#
# This list was verified with `dnf remove --assumeno`: 61 packages, ~354MB,
# and no DNFfile package touched. Re-verify the same way before extending it.
PLASMA_CRUFT=(
  plasma-drkonqi              # the crash-looping culprit
  plasma-discover             # + its flatpak/kns/libs/notifier/packagekit subpackages
  plasma-welcome              # + plasma-welcome-fedora
  plasma-disks
  plasma-thunderbolt          # pulls bolt; no TB devices enrolled on noelle
  plasma-vault                # pulls cryfs/gocryptfs/fuse-encfs
  plasma-systemmonitor
  plasma-milou
  plasma-browser-integration
  plasma-print-manager        # + -libs
  plasma-pa
  plasma-nm                   # + 6 VPN applets; pulls openvpn/openconnect/vpnc/
                              # pptp/libreswan. NetworkManager itself is kept,
                              # and noelle has no VPN connections configured.
  plasma-setup
  plasma-desktop-doc
  plasma-workspace-wallpapers
)

# KDE PIM — the spin's mail/calendar/contacts suite. Not Plasma proper, hence a
# separate list, but the same class of leftover.
#
# kalendarac ("Calendar Reminders", from akonadi-calendar) autostarted and died
# at every login with a symbol lookup error: messagelib wants
# setFormatTypes(const QFlags<...>&) while ktextaddons-qt6 2.0.1 ships it by
# value. The soname stayed .so.1 across that ABI break, so RPM's dependency
# check never caught it — nothing to fix locally, and none of this suite is used
# here (no mail account, calendar, or address book was ever configured).
#
# akonadi-calendar drags the rest of the suite out with it: calendarsupport,
# eventviews, incidenceeditor, kdepim-addons, kdepim-runtime, kmail, kontact,
# korganizer and their -libs. akregator and kaddressbook are NOT in that
# closure, so they're listed explicitly — leaving either behind keeps the whole
# akonadi server stack alive, which defeats the point.
KDEPIM_CRUFT=(
  akonadi-calendar
  akregator
  kaddressbook
)

setup-deplasma() {
  if ! is-fedora; then
    return
  fi

  # Build the removal list from what's actually installed, so re-runs are a
  # cheap no-op and a partially-removed system still converges.
  local targets=()
  local pkg
  for pkg in "${PLASMA_CRUFT[@]}" "${KDEPIM_CRUFT[@]}"; do
    rpm -q "$pkg" &> /dev/null && targets+=("$pkg")
  done

  # plasma-login-manager is the Fedora KDE spin's display manager (there is no
  # sddm on a stock KDE install). Only remove it once sddm has actually taken
  # over, or the machine is left with no graphical login. setup-sddm runs first
  # in run-desktop and does that switch; this guard is the backstop.
  if rpm -q plasma-login-manager &> /dev/null; then
    local active_dm
    active_dm="$(basename "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)" 2>/dev/null)"
    if [[ "$active_dm" == "sddm.service" ]]; then
      targets+=(plasma-login-manager)
    else
      warn "Keeping plasma-login-manager: sddm is not the active display manager (found: ${active_dm:-none})."
    fi
  fi

  if [[ ${#targets[@]} -eq 0 ]]; then
    return
  fi

  substep "Removing ${#targets[@]} unused Plasma / KDE PIM packages..."
  sudo dnf remove -y "${targets[@]}" \
    || bootstrap_error "Failed to remove the Plasma / KDE PIM cruft" \
      "Inspect the transaction manually: sudo dnf remove --assumeno ${targets[*]}"

  # With the PIM suite gone, akonadi's database under ~/.local/share/akonadi is
  # orphaned — on this machine ~113MB of an empty MariaDB instance the server
  # creates on first start. Deliberately NOT deleted automatically: telling an
  # empty akonadi from one holding a real local mail store means inspecting the
  # resource data, and no heuristic worth trusting fits in a bootstrap step. A
  # fresh machine never accumulates it, so it isn't reproducible state either.
  # Report it and let the operator decide.
  if [[ -d "$HOME/.local/share/akonadi" ]]; then
    notice "Orphaned akonadi DB left at ~/.local/share/akonadi ($(du -sh "$HOME/.local/share/akonadi" 2> /dev/null | cut -f1))."
    notice "If no mail/calendar was ever configured: rm -rf ~/.local/share/akonadi ~/.config/akonadi"
  fi

  # drkonqi's user units go with the package; drop the mask symlinks used to
  # muzzle the crash loop while it was still installed.
  rm -f "$HOME/.config/systemd/user/drkonqi-coredump-launcher.socket" \
        "$HOME/.config/systemd/user/drkonqi-coredump-pickup.service" \
        "$HOME/.config/systemd/user/drkonqi-coredump-cleanup.timer"

  # Restore the stock coredump handler. Breaking the loop by hand means
  # pointing kernel.core_pattern at /bin/false; with drkonqi gone,
  # systemd-coredump is safe again. sysctl --system re-reads the shipped
  # /usr/lib/sysctl.d/50-coredump.conf.
  sudo sysctl --system &> /dev/null || true
}

# Cap how much disk systemd-coredump may consume. The drkonqi crash loop wrote
# 4.1GB of cores over ten days without anything noticing; the stock default
# (10% of the filesystem) is far too generous to act as a warning signal.
# This is a backstop, not the fix — see setup-deplasma for the actual cause.
setup-coredump-limits() {
  if ! is-fedora; then
    return
  fi

  local conf="/etc/systemd/coredump.conf.d/juliet.conf"
  if [[ -f "$conf" ]]; then
    return
  fi

  substep "Capping systemd-coredump disk usage..."
  sudo install -d -m 755 /etc/systemd/coredump.conf.d \
    || bootstrap_error "Failed to create /etc/systemd/coredump.conf.d" \
      "Create it manually: sudo install -d -m 755 /etc/systemd/coredump.conf.d"
  sudo tee "$conf" > /dev/null << 'EOF'
# Managed by Juliet (bin/juliet-bootstrap :: setup-coredump-limits).
# A runaway crash loop once wrote 4.1GB of cores here unnoticed; these caps
# keep any repeat bounded.
[Coredump]
MaxUse=512M
KeepFree=2G
ProcessSizeMax=256M
EOF
}

# Pinned Nerd Fonts release used for fonts too large to vendor (Iosevka).
NERD_FONTS_VERSION="v3.4.0"

# User-writable font directory for the current OS.
font-dir() {
  if is-macos; then
    echo "$HOME/Library/Fonts"
  else
    echo "$HOME/.local/share/fonts"
  fi
}

# Install fonts and refresh the font cache. Two sources:
#   1. Small TTF/OTFs vendored in etc/fonts (3270, Berkeley Mono, JetBrains
#      Mono, MonoLisa) — copied straight in.
#   2. Iosevka Nerd Font Mono — the primary terminal/editor font
#      (ghostty font-family, neovide guifont). Its v3.x weights are ~13MB
#      each, too big to vendor, so the four core Mono weights are pulled from
#      the pinned Nerd Fonts release and cached. The 374MB zip is only fetched
#      when Iosevka isn't already installed, so re-runs are cheap.
# Everything lands in <font-dir>/Juliet so the repo owns that subtree.
# The RPMFusion nvidia driver is compiled locally by akmods and signed with a
# key this machine generates itself (/etc/pki/akmods/certs/public_key.der). With
# Secure Boot on, the kernel refuses to load a module whose key isn't enrolled in
# the firmware's MOK store — and nothing announces it: nvidia-fallback.service
# quietly loads nouveau instead, so the display works and the breakage hides.
# The cost is real though — CUDA is dead despite the -cuda packages being
# installed, nouveau can't reclock Turing so the dGPU runs slow, and
# nvidia-powerd fails with "Allocate Root client failed". The only visible
# symptom was nvidia-settings failing at login with "NVIDIA driver is not
# loaded".
#
# `mokutil --import` only *stages* the key and sets a one-time password; the
# enrollment itself happens in the firmware's MOK Manager screen on the next
# boot and deliberately cannot be automated — physical presence is the point.
setup-nvidia-secureboot() {
  if ! is-fedora; then
    return
  fi
  if ! rpm -q akmod-nvidia &> /dev/null; then
    return
  fi
  # Secure Boot off means unsigned modules load fine — nothing to enroll.
  if ! mokutil --sb-state 2> /dev/null | grep -q 'SecureBoot enabled'; then
    return
  fi
  # The proprietary module loading at all proves the key is already trusted.
  # Tested via /proc/driver/nvidia rather than lsmod: the in-tree
  # nvidia-wmi-ec-backlight module (present on this Dell) loads as
  # "nvidia_wmi_ec_backlight" and would false-match a /^nvidia/ grep, silently
  # skipping enrollment forever. Only the real driver creates this directory.
  if [[ -d /proc/driver/nvidia ]]; then
    skip "nvidia driver loaded (MOK key already enrolled)"
    return
  fi
  # A key staged by an earlier run is still waiting on the reboot; importing
  # again would just overwrite the pending request with a new password.
  if mokutil --list-new 2> /dev/null | grep -q .; then
    warn "An akmods key is already staged. Reboot and complete MOK Manager to finish."
    return
  fi

  local key=/etc/pki/akmods/certs/public_key.der
  if ! sudo test -f "$key"; then
    bootstrap_error "akmods signing key not found at $key" \
      "Rebuild the module first: sudo akmods --force"
    return
  fi

  substep "Enrolling the akmods signing key so Secure Boot will load nvidia..."
  notice "mokutil asks for a one-time password — you re-enter it in MOK Manager on reboot."
  # Interactive (prompts twice for the password), so deliberately not wrapped in
  # spin() — the spinner would hide the prompt and look like a hang.
  if sudo mokutil --import "$key"; then
    warn "Reboot to finish: MOK Manager -> Enroll MOK -> Continue -> Yes -> that password."
  else
    bootstrap_error "Failed to stage the akmods key for MOK enrollment" \
      "Retry manually: sudo mokutil --import $key"
  fi
}

# The nvidia driver ships Runtime D3 disabled — /proc/driver/nvidia/gpus/*/power
# reports "Runtime D3 status: Disabled by default" — so on a laptop the dGPU
# stays powered from boot even when nothing is using it. Under nouveau this
# machine's GTX 1650 Ti idled in D3cold; the first boot on the proprietary
# driver had it in D0 for the entire session (runtime_suspended_time 0, active
# 555s). That is pure battery drain and heat on a box whose history includes a
# 100°C thermal runaway — so enabling RTD3 is part of switching drivers, not an
# optional extra.
#
# 0x02 is NVIDIA's most aggressive tier: power the GPU down, video memory
# included, once idle. It needs Turing or newer (this is TU117) plus hardware
# support, both confirmed here — "Video Memory Off: Supported" and "S0ix Platform
# Support: Supported". Where unsupported the driver simply won't engage it.
#
# The udev half already ships with the driver (80-nvidia-pm.rules sets
# power/control=auto on bind for PCI class 0x030200), and nvidia is not in the
# initramfs — no nvidia arguments on the kernel cmdline, and the module loads
# after root is mounted — so modprobe.d alone is enough. No dracut regeneration,
# but it does need a reboot to take effect.
setup-nvidia-powermgmt() {
  if ! is-fedora; then
    return
  fi
  if ! rpm -q akmod-nvidia &> /dev/null; then
    return
  fi

  local conf="/etc/modprobe.d/juliet-nvidia-pm.conf"
  if [[ -f "$conf" ]]; then
    return
  fi

  substep "Enabling nvidia Runtime D3 so the dGPU powers down when idle..."
  sudo tee "$conf" > /dev/null << 'EOF'
# Managed by Juliet (bin/juliet-bootstrap :: setup-nvidia-powermgmt).
# The driver leaves Runtime D3 off by default, which keeps the dGPU powered for
# the whole session on a laptop. 0x02 powers it down (video memory included)
# once idle. Verify after a reboot with:
#   cat /proc/driver/nvidia/gpus/*/power
#   cat /sys/bus/pci/devices/0000:01:00.0/power/runtime_status
options nvidia NVreg_DynamicPowerManagement=0x02
EOF
  if [[ ! -f "$conf" ]]; then
    bootstrap_error "Failed to write $conf" \
      "Create it manually with: options nvidia NVreg_DynamicPowerManagement=0x02"
    return
  fi
  notice "nvidia Runtime D3 takes effect on the next reboot."
}

# How long crash evidence is worth keeping. Long enough to debug something that
# happened "the other day", short enough that a crash loop can't quietly hoard
# disk between bootstrap runs.
CRASH_RETENTION_DAYS=7

# Age-based purge of accumulated crash data. setup-coredump-limits already caps
# systemd-coredump's *size*, but nothing bounded abrt's spool: the drkonqi loop
# left 45 stale reports there, one with a repeat count of 46515. Expressed as a
# retention window rather than a one-shot wipe so it stays idempotent and keeps
# converging on every run.
setup-crash-purge() {
  if ! is-fedora; then
    return
  fi

  # abrt problem directories are named ccpp-<date>-... and owned by root; -mtime
  # is what decides, not the name, so a clock skew can't delete recent evidence.
  if [[ -d /var/spool/abrt ]]; then
    local stale
    stale=$(sudo find /var/spool/abrt -mindepth 1 -maxdepth 1 -type d \
      -mtime +"$CRASH_RETENTION_DAYS" 2> /dev/null | wc -l)
    if [[ "$stale" -gt 0 ]]; then
      substep "Purging $stale abrt report(s) older than ${CRASH_RETENTION_DAYS}d..."
      sudo find /var/spool/abrt -mindepth 1 -maxdepth 1 -type d \
        -mtime +"$CRASH_RETENTION_DAYS" -exec rm -rf {} + \
        || bootstrap_error "Failed to purge the stale abrt spool" \
          "Inspect it manually: sudo du -sh /var/spool/abrt/*"
    fi
  fi

  # coredumpctl has no age-based vacuum of its own, so drive it off the files.
  if [[ -d /var/lib/systemd/coredump ]]; then
    local cores
    cores=$(find /var/lib/systemd/coredump -type f \
      -mtime +"$CRASH_RETENTION_DAYS" 2> /dev/null | wc -l)
    if [[ "$cores" -gt 0 ]]; then
      substep "Purging $cores core dump(s) older than ${CRASH_RETENTION_DAYS}d..."
      sudo find /var/lib/systemd/coredump -type f \
        -mtime +"$CRASH_RETENTION_DAYS" -delete \
        || bootstrap_error "Failed to purge old core dumps" \
          "Inspect them manually: coredumpctl list"
    fi
  fi
}

setup-fonts() {
  substep "Installing fonts..."
  local dest="$(font-dir)/Juliet"
  mkdir -p "$dest"

  # 1. Vendored fonts (flattened into dest; fontconfig/CoreText recurse anyway)
  local vendored="$HOME/.config/Juliet/etc/fonts"
  if [[ -d "$vendored" ]]; then
    find "$vendored" -type f \( -iname '*.ttf' -o -iname '*.otf' \) \
      -exec cp -f {} "$dest/" \;
  fi

  # 2. Iosevka Nerd Font Mono (download + extract the four core Mono weights)
  if [[ -f "$dest/IosevkaNerdFontMono-Regular.ttf" ]]; then
    skip "Iosevka Nerd Font Mono already installed — skipping download"
  else
    local url="https://github.com/ryanoasis/nerd-fonts/releases/download/${NERD_FONTS_VERSION}/Iosevka.zip"
    local tmp
    tmp="$(mktemp -d)"
    if spin "Downloading Iosevka Nerd Font Mono (${NERD_FONTS_VERSION}, ~374MB, one-time)..." \
         curl -fL --retry 2 -o "$tmp/Iosevka.zip" "$url"; then
      unzip -o -j "$tmp/Iosevka.zip" \
        'IosevkaNerdFontMono-Regular.ttf' \
        'IosevkaNerdFontMono-Bold.ttf' \
        'IosevkaNerdFontMono-Italic.ttf' \
        'IosevkaNerdFontMono-BoldItalic.ttf' \
        -d "$dest" > /dev/null \
        || bootstrap_error "Failed to extract Iosevka Nerd Font Mono from Iosevka.zip"
    else
      bootstrap_error "Failed to download Iosevka Nerd Font Mono" \
        "Fetch manually from https://github.com/ryanoasis/nerd-fonts/releases/tag/${NERD_FONTS_VERSION}"
    fi
    rm -rf "$tmp"
  fi

  # 3. Refresh the font cache (macOS picks fonts up automatically and may not
  # ship fc-cache, so only run it when present).
  if command -v fc-cache &> /dev/null; then
    fc-cache -f "$(font-dir)" > /dev/null 2>&1 || true
  fi
}

# claude-statusline renders the Claude Code status line (the `statusLine` block
# in symlinked/home/.claude/settings.json), reading
# symlinked/config/claude-statusline/config.toml.
#
# We install OUR FORK, not upstream: it adds width-aware per-module priorities
# (rank a module with `priority = N` and it drops, with its separator, when the
# line won't fit COLUMNS) plus a `[fit] margin` knob. Upstream has neither.
#
# The fork's go.mod declares the fork's own module path, so a plain `go install`
# works. (It briefly kept upstream's path to stay PR-able upstream, which made
# the fork uninstallable by its own URL — Go resolves module identity from go.mod
# and rejects the mismatch. Ease of install won.)
#
# PINNED TO @main, AND NEITHER @latest NOR A BRANCH NAME. Two traps here:
#   1. `@latest` resolves to the newest *semver tag*, and the fork inherited
#      upstream's v0.7-v0.9 tags — so it installs a working binary silently
#      missing the priorities feature we forked for. Verified.
#   2. `go install pkg@some/branch` is rejected outright: "invalid version …
#      disallowed version string". Version queries can't contain a slash, so
#      feat/module-priorities is unusable here. The feature branch was
#      fast-forwarded into the fork's main to give a slash-free ref.
#
# No `command -v` guard: main moves, so re-running picks up new commits. Go's
# module cache keeps that cheap when nothing changed. (First install of a new
# module path can be slow while proxy.golang.org fetches it; subsequent ones are
# fast, and it's already warmed.)
CLAUDE_STATUSLINE_PKG="github.com/avegancafe/claude-statusline"
CLAUDE_STATUSLINE_REF="main"

setup-claude-statusline() {
  if ! command -v go &> /dev/null; then
    bootstrap_error "go not found — cannot install claude-statusline." \
      "Fedora: the 'golang' DNFfile entry. macOS: 'brew \"go\"' in the Brewfile." \
      "Then re-run: juliet-bootstrap --enable=claude"
    return
  fi

  # GOPRIVATE bypasses proxy.golang.org and the checksum DB for this module only.
  # Without it, `@main` is served from the proxy's cached branch resolution, which
  # lags behind the real tip — observed installing a commit old enough to predate
  # a field the tracked config.toml references, producing "(statusline error)" with
  # a green exit. A personal fork wants the direct fetch.
  spin "Installing claude-statusline (${CLAUDE_STATUSLINE_REF})..." \
    env GOPRIVATE='github.com/avegancafe/*' go install "${CLAUDE_STATUSLINE_PKG}@${CLAUDE_STATUSLINE_REF}" \
    || bootstrap_error "Failed to install claude-statusline — the Claude Code status line will render nothing." \
      "Retry manually: go install ${CLAUDE_STATUSLINE_PKG}@${CLAUDE_STATUSLINE_REF}"
}

setup-claude-code() {
  if ! command -v claude &> /dev/null; then
    rlog "Installing Claude CLI..."
    curl -fsSL https://claude.ai/install.sh | bash
  else
    skip "Claude CLI already installed — skipping"
  fi

  # Configure git to authenticate GitHub over HTTPS via the gh CLI. Claude Code
  # clones marketplaces/plugins over HTTPS, so private ones (e.g. the
  # avegancafe-marketplace referenced in settings.json) fail to clone without an
  # HTTPS credential helper. We write it to the machine-local gitconfig (included
  # by the tracked ~/.gitconfig) rather than running `gh auth setup-git`, which
  # would bake a machine-specific absolute gh path into the tracked dotfile. The
  # `!gh ...` form resolves gh from PATH, so it stays portable across macOS/Fedora.
  if command -v gh &> /dev/null; then
    if gh auth status &> /dev/null; then
      substep "Configuring gh as the git credential helper for GitHub (HTTPS access to private repos)..."
      mkdir -p "$HOME/.config/local"
      git config --file "$HOME/.config/local/gitconfig" credential."https://github.com".helper "!gh auth git-credential"
      git config --file "$HOME/.config/local/gitconfig" credential."https://gist.github.com".helper "!gh auth git-credential"
    else
      warn "gh is installed but not authenticated — private plugin marketplaces won't clone over HTTPS."
      warn "Run 'gh auth login', then re-run: juliet-bootstrap --enable=claude"
    fi
  else
    warn "gh not found; skipping git credential-helper setup."
    warn "Private plugin marketplaces won't clone over HTTPS until gh is installed and authenticated."
  fi

  # Define marketplaces to add
  # Format: "name:id" pairs (bash 3.2 compatible)
  marketplaces=(
    "superpowers-marketplace:obra/superpowers-marketplace"
    "claude-plugins-official:anthropics/claude-plugins-official"
  )

  # Add marketplaces if not already registered
  for marketplace_pair in "${marketplaces[@]}"; do
    marketplace_name="${marketplace_pair%%:*}"
    marketplace_id="${marketplace_pair#*:}"
    if ! claude plugin marketplace list 2>/dev/null | grep -Fq "$marketplace_name"; then
      spin "Adding $marketplace_name marketplace..." claude plugin marketplace add "$marketplace_id" \
        || warn "Failed to add $marketplace_name marketplace (non-fatal)."
    fi
  done

  # Define plugins to install
  plugins=(
    "superpowers@superpowers-marketplace"
    "frontend-design@claude-plugins-official"
    "context7@claude-plugins-official"
    "sentry@claude-plugins-official"
    "linear@claude-plugins-official"
    "playwright@claude-plugins-official"
  )

  # Install plugins if not already installed
  for plugin in "${plugins[@]}"; do
    if ! claude plugin list 2>/dev/null | grep -Fq "$plugin"; then
      spin "Installing $plugin..." claude plugin install "$plugin" \
        || bootstrap_error "Failed to install $plugin — run 'claude plugin install $plugin' manually."
    fi
  done
}

setup-opencode() {
  if ! command -v opencode &> /dev/null; then
    rlog "Installing opencode CLI..."
    curl -fsSL https://opencode.ai/install | bash
  else
    skip "opencode already installed — skipping"
  fi

  # Config layering (Juliet does NOT stow opencode.json or tui.json):
  #   global  ~/.config/opencode/opencode.json   owned by dev-env's `j2 bootstrap`
  #           (fill-undefined merge: pinned j2 plugins, team MCP servers,
  #           permission baseline, mcp/lsp fragments — yields to local values)
  #   custom  $OPENCODE_CONFIG                    Juliet's opencode/config.json,
  #           exported from fish/env.fish (opencode.json-space keys only —
  #           NEVER the deprecated theme/tui/keybinds keys: opencode rewrites
  #           any config file containing them in place, which would dirty
  #           this repo; verified on 1.18.0)
  #   project <repo>/opencode.json                per-repo overrides
  # opencode loads them in that precedence order, so Juliet's keys override the
  # dev-env defaults without either bootstrap touching the other's file.
  # plugins/cmux.js stays stow-symlinked (immutable content — nothing writes
  # to plugins/). Interactive theme picks persist to
  # ~/.local/state/opencode/kv.json, never a config file.

  # Migration: an earlier revision of this branch stow-symlinked opencode.json
  # into ~/.config/opencode. dev-env's jq merges write via mv(1), which would
  # silently replace that symlink with a real file and break the stow link.
  # Remove the stale Juliet-owned link so dev-env can manage the global file.
  local oc_json="$HOME/.config/opencode/opencode.json"
  if [[ -L "$oc_json" ]] && readlink "$oc_json" | grep -q "$HOME/.config/Juliet/"; then
    rlog "Removing stale Juliet stow link for opencode.json (now layered via OPENCODE_CONFIG; run 'j2 bootstrap' to lay down the dev-env global file)"
    rm "$oc_json"
  fi

  # tui.json is SEEDED (copied once), never symlinked: opencode itself writes
  # tui.json (deprecated-key migrations), and a write through a symlink would
  # dirty this repo. After the seed, your theme settings are yours.
  local tui_src="$HOME/.config/Juliet/opencode/tui.json"
  local tui_dst="$HOME/.config/opencode/tui.json"
  if [[ -L "$tui_dst" ]] && readlink "$tui_dst" | grep -q "$HOME/.config/Juliet/"; then
    rlog "Converting stow-linked tui.json to a real file (opencode writes tui.json; a link would dirty the repo)..."
    rm "$tui_dst"
    cp "$tui_src" "$tui_dst"
  elif [[ ! -f "$tui_dst" ]]; then
    substep "Seeding ~/.config/opencode/tui.json (theme: system)..."
    cp "$tui_src" "$tui_dst"
  else
    skip "tui.json already present — leaving your theme settings alone"
  fi

  # OPENCODE_CONFIG is exported by the stowed fish/env.fish; it only reaches
  # shells started after the stow run, so hint when the current shell lacks it.
  if [[ -z "${OPENCODE_CONFIG:-}" ]]; then
    warn "OPENCODE_CONFIG not set in this shell yet — open a new shell (or 'source ~/.config/fish/env.fish') so opencode picks up Juliet's override layer."
  fi

  # The cmux notification plugin (plugins/cmux.js) auto-loads and rings the
  # cmux workspace tab when the agent goes idle or errors. It's a no-op
  # outside a cmux session, but warn if the cmux CLI is missing so the user
  # knows notifications won't fire.
  if ! command -v cmux &> /dev/null; then
    warn "cmux CLI not found — opencode→cmux notifications stay inactive until cmux is installed."
  fi
}

# =============================================================================
# Category Runner Functions
# =============================================================================

run-packages() {
  confirm-category "packages" "Install system packages? (neovim, bat, ripgrep, fzf, gh, starship, ghostty...)" || return
  rlog "📦 Installing system packages..."
  if is-macos; then
    setup-brew
  elif is-fedora; then
    setup-dnf
    setup-flatpak
  fi
}

run-fonts() {
  confirm-category "fonts" "Install fonts? (Iosevka Nerd Font Mono + vendored 3270/Berkeley/JetBrains/MonoLisa)" || return
  rlog "🔤 Installing fonts..."
  setup-fonts
}

run-dev() {
  confirm-category "dev" "Install dev tools? (rust/cargo, stylua, poetry, nodenv, prettier/eslint)" || return
  rlog "🛠️ Installing dev tools..."
  setup-cargo
  setup-rust
  setup-python
  setup-nodenv
  setup-node-tools
}

run-shell() {
  confirm-category "shell" "Configure shell? (fish as default, fzf keybindings, tmux plugins)" || return
  log "🐚 Configuring shell..."
  setup-fish
  setup-fzf
  setup-tmux-plugins
}

run-security() {
  confirm-category "security" "Set up security? (SSH key, GPG agent)" || return
  log "🔐 Setting up security..."
  setup-ssh
  setup-gpg
  setup-cyberduck
}

run-desktop() {
  # Only show on Linux with relevant tools. Noctalia (the niri shell) needs no
  # setup step here: it's installed via the DNFfile and started by
  # spawn-at-startup in the niri config. Each setup-* step self-guards on the
  # tool it configures, so only skip the whole category when none are present.
  if ! is-fedora; then return; fi
  # setup-deplasma has work to do even when neither greeter nor keyd is
  # installed yet, so leftover Plasma / KDE PIM cruft also keeps the category
  # alive — as does an nvidia driver still waiting on MOK enrollment.
  if ! command -v sddm &> /dev/null \
    && ! command -v keyd &> /dev/null \
    && ! rpm -q plasma-drkonqi &> /dev/null \
    && ! rpm -q akonadi-calendar &> /dev/null \
    && ! rpm -q akmod-nvidia &> /dev/null; then
    return
  fi

  confirm-category "desktop" "Configure desktop? (sddm greeter + theme, keyd Super-tap remap, Plasma/PIM cleanup, nvidia Secure Boot)" || return
  log "🖥️ Configuring desktop..."
  # Order matters: setup-sddm must enable sddm as the display manager before
  # setup-deplasma removes plasma-login-manager, or there's no way to log in.
  setup-sddm
  setup-deplasma
  setup-coredump-limits
  setup-crash-purge
  setup-nvidia-secureboot
  setup-nvidia-powermgmt
  setup-keyd
}

run-claude() {
  confirm-category "claude" "Set up Claude Code? (CLI, statusline, superpowers, context7, LSP plugins)" || return
  rlog "🤖 Setting up Claude Code..."
  setup-claude-code
  setup-claude-statusline
}

run-opencode() {
  confirm-category "opencode" "Set up opencode? (CLI + cmux notification plugin)" || return
  rlog "🤖 Setting up opencode..."
  setup-opencode
}

# =============================================================================
# Main Execution
# =============================================================================

# Core setup (always runs)
log "🚀 Bootstrapping Juliet..."
ensure-bootstrap-deps
setup-git
update-juliet
symlink-dotfiles

# Category-based setup
run-packages
run-fonts
run-dev
run-shell
run-security
run-desktop
run-claude
run-opencode

print-bootstrap-summary
