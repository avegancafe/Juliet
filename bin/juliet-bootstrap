#! /bin/bash
# shellcheck disable=SC2034  # globals set here are read by the bootstrap.d modules

# Bootstrap's own code (_util.bash, bootstrap.d/) loads from next to this
# script. Its data — etc/, the package files, symlinked/, and the repo it
# pulls — still comes from $JULIET_DIR (~/.config/Juliet) below.
JULIET_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$JULIET_BIN/../_util.bash"

# Captured before any arg parsing touches "$@" (the JULIET_BOOTSTRAP_ARGS env
# var below reassigns it via `set --`), so a self re-exec after a git pull
# (see update-juliet) can replay the invocation exactly as the user typed it.
ORIGINAL_ARGS=("$@")

# Abort the whole script when the user hits Ctrl+C, instead of letting
# individual prompts treat it as "No" and falling through to the next step.
on-interrupt() {
  echo
  warn "Cancelled."
  if [[ -n "${BREW_BUNDLE_LOG:-}" && -f "$BREW_BUNDLE_LOG" ]]; then
    warn "brew bundle output so far: $BREW_BUNDLE_LOG"
  fi
  exit 130
}
trap on-interrupt INT

# gum confirm exits 0 for yes, 1 for no, 130 for Ctrl+C. Treat anything other
# than yes/no as a cancellation of the whole bootstrap.
gum-confirm() {
  gum confirm "$@"
  local rc=$?
  if [[ $rc -ne 0 && $rc -ne 1 ]]; then
    on-interrupt
  fi
  return $rc
}

# Non-fatal error handling: an optional step that fails shouldn't abort the
# whole bootstrap. Guard such steps with
#   <step> || bootstrap_error "<summary>" ["<detail line>"...]
# The summary is logged immediately (via error()) with any detail lines —
# remedy commands, paths — indented under it, recorded, and the whole entry is
# re-reported by print-bootstrap-summary at the end, while bootstrap keeps
# going. Keep each line short; put commands on their own detail line instead
# of inlining them in the summary.
BOOTSTRAP_ERRORS=()

bootstrap_error() {
  local summary="$1"
  shift
  error "$summary"
  local line
  for line in "$@"; do
    printf "      %s\n" "$line" >&2
  done
  BOOTSTRAP_ERRORS+=("$(printf '%s\n' "$summary" "$@")")
}

print-bootstrap-summary() {
  if [[ ${#BOOTSTRAP_ERRORS[@]} -eq 0 ]]; then
    log "🎉 Done!"
    return 0
  fi
  echo
  warn "Bootstrap finished with ${#BOOTSTRAP_ERRORS[@]} error(s):"
  local entry line printed
  for entry in "${BOOTSTRAP_ERRORS[@]}"; do
    printed=""
    while IFS= read -r line; do
      if [[ -z "$printed" ]]; then
        error "  • $line"
        printed=1
      else
        printf "        %s\n" "$line" >&2
      fi
    done <<< "$entry"
  done
  return 1
}

# Global flags
YES_ALL="false"
NO_ALL="false"
ENABLED_STEPS=()
SKIPPED_STEPS=()
SSH_EMAIL=""
LIST_ONLY="false"

JULIET_DIR="$HOME/.config/Juliet"
# Machine-local secrets and settings (never committed). Bootstrap reads single
# keys from it and appends missing ones, but never prints its contents.
LOCAL_ENV="$HOME/.config/local/.env"
# Where active extensions are exposed, one per name (a symlink to a local path,
# or a clone of a git URL), with .order and a generated gitconfig so static
# hooks (.gitconfig, fish) can find them. See EXTENSIONS.md.
EXTENSIONS_ROOT="$HOME/.config/juliet-extensions"
# Active extensions' directories, in JULIET_EXTENSION order.
EXTENSION_DIRS=()
# The extension whose bootstrap.bash is running (set per extension).
EXTENSION_DIR=""
EXTENSION_ACTIVE="false"
# Package files bootstrap installs from. setup-extension swaps in combined
# copies (Juliet's minus the extensions' `exclude`, plus each extension's own).
JULIET_BREWFILE="$JULIET_DIR/Brewfile"
JULIET_DNFFILE="$JULIET_DIR/DNFfile"
JULIET_FLATPAKFILE="$JULIET_DIR/Flatpakfile"

# Steps live in bin/bootstrap.d/, one file per category (plus 00-common for
# the registry/runner and 05-core for the always-run phases). Sourced in
# name order, so the numeric prefix sets the order categories run in.
BOOTSTRAP_D="$JULIET_BIN/bootstrap.d"
if [[ ! -f "$BOOTSTRAP_D/00-common.bash" ]]; then
  fatal "Missing $BOOTSTRAP_D — is the Juliet checkout complete? Try: git -C \"$JULIET_BIN/..\" status"
fi
for _module in "$BOOTSTRAP_D"/*.bash; do
  # shellcheck source=/dev/null
  source "$_module"
done
unset _module

show-help() {
  local categories="${CATEGORIES[*]}"
  # Plain heredocs (not inside $(...)): bash 3.2 misparses an apostrophe in a
  # heredoc within command substitution.
  cat << 'EOF'
Usage: juliet-bootstrap [OPTIONS]

Options:
  -y, --yes              Accept all prompts
  -n, --no               Decline all prompts
  --enable=STEPS         Only run these steps (comma-separated)
  --skip=STEPS           Skip these steps (comma-separated)
  --ssh-email=EMAIL      Email for SSH key generation
  --list                 Show every category and step, and which apply here
  -h, --help             Show this help message

EOF
  printf 'Categories: %s\n' "${categories// /, }"
  cat << 'EOF'
Each category's steps can also be named on their own (e.g. --enable=keyd);
run --list to see them.

Examples:
  juliet-bootstrap -y                        # Accept all prompts
  juliet-bootstrap -y --skip=packages        # All except packages
  juliet-bootstrap --enable=shell,security   # Only shell and security
  juliet-bootstrap --enable=keyd             # Only the keyd step
  juliet-bootstrap --skip=fingerprint        # Everything but one step
  juliet-bootstrap --enable=security --ssh-email=test@example.com

Environment Variables:
  JULIET_BOOTSTRAP_ARGS  Default arguments when no CLI args provided
                         Any CLI argument disables the env var
  JULIET_EXTENSION       Git URL or local path of your Juliet extension
                         (usually set in ~/.config/local/.env; see EXTENSIONS.md)

Environment variable example:
  export JULIET_BOOTSTRAP_ARGS="-y --skip=packages"
  juliet-bootstrap              # Uses env var
  juliet-bootstrap --no         # Ignores env var, uses only CLI args
EOF
}

# Parse environment variable arguments only if no CLI args provided
if [[ $# -eq 0 && -n "${JULIET_BOOTSTRAP_ARGS:-}" ]]; then
  eval "set -- $JULIET_BOOTSTRAP_ARGS"
fi

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -y|--yes)
      YES_ALL="true"
      shift
      ;;
    -n|--no)
      NO_ALL="true"
      shift
      ;;
    --enable=*)
      IFS=',' read -ra ENABLED_STEPS <<< "${1#*=}"
      shift
      ;;
    --skip=*)
      IFS=',' read -ra SKIPPED_STEPS <<< "${1#*=}"
      shift
      ;;
    --ssh-email=*)
      SSH_EMAIL="${1#*=}"
      shift
      ;;
    --list)
      LIST_ONLY="true"
      shift
      ;;
    -h|--help)
      show-help
      exit 0
      ;;
    *)
      warn "Unknown option: $1"
      show-help
      exit 1
      ;;
  esac
done

# =============================================================================
# Main Execution
# =============================================================================

# Sourced (by tests) instead of executed: stop here with every function and the
# category registry defined, but nothing run.
[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

validate-step-names
if [[ "$LIST_ONLY" == "true" ]]; then
  list-steps
  exit 0
fi

# Core setup (always runs).
#
# The phase boundary that matters is update-juliet: it may exec a freshly
# pulled copy of this script, so everything ABOVE it runs twice on a
# self-update and everything below runs once. Keep the pre-pull phase to the
# bare minimum needed to reach the pull — stow and gum — and put every step
# that consumes repo content after it, so it reads the version just pulled.
log "🚀 Bootstrapping Juliet..."
ensure-bootstrap-deps

log "🔄 Updating Juliet..."
update-juliet

# After the pull (it reads repo content) and before linking + packages, which
# both layer the extension on top of Juliet.
log "🧩 Loading extension..."
setup-extension

# Both steps materialize config into $HOME — setup-git seeds the one git file
# that can't be stowed (machine-local identity, gitignored), symlink-dotfiles
# stows the tracked rest — so they belong in one phase, after the pull.
log "🔗 Linking dotfiles..."
setup-git
symlink-dotfiles

# Category-based setup (see the Category Registry near the top)
run-categories

print-bootstrap-summary
