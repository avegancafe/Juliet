#! /bin/bash

source ~/.config/Juliet/_util.bash

# Abort the whole script when the user hits Ctrl+C, instead of letting
# individual prompts treat it as "No" and falling through to the next step.
on-interrupt() {
  echo
  warn "Cancelled."
  exit 130
}
trap on-interrupt INT

# gum confirm exits 0 for yes, 1 for no, 130 for Ctrl+C. Treat anything other
# than yes/no as a cancellation of the whole bootstrap.
gum-confirm() {
  gum confirm "$@"
  local rc=$?
  if [[ $rc -ne 0 && $rc -ne 1 ]]; then
    on-interrupt
  fi
  return $rc
}

# Global flags
YES_ALL="false"
NO_ALL="false"
ENABLED_STEPS=()
SKIPPED_STEPS=()
SSH_EMAIL=""

show-help() {
  cat << 'EOF'
Usage: juliet-bootstrap [OPTIONS]

Options:
  -y, --yes              Accept all prompts
  -n, --no               Decline all prompts
  --enable=STEPS         Only run these steps (comma-separated)
  --skip=STEPS           Skip these steps (comma-separated)
  --ssh-email=EMAIL      Email for SSH key generation
  -h, --help             Show this help message

Steps: packages (includes flatpak), dev, shell, security, desktop, claude

Examples:
  juliet-bootstrap -y                        # Accept all prompts
  juliet-bootstrap -y --skip=packages        # All except packages
  juliet-bootstrap --enable=shell,security   # Only shell and security
  juliet-bootstrap --enable=security --ssh-email=test@example.com

Environment Variables:
  JULIET_BOOTSTRAP_ARGS  Default arguments when no CLI args provided
                         Any CLI argument disables the env var

Environment variable example:
  export JULIET_BOOTSTRAP_ARGS="-y --skip=packages"
  juliet-bootstrap              # Uses env var
  juliet-bootstrap --no         # Ignores env var, uses only CLI args
EOF
}

# Parse environment variable arguments only if no CLI args provided
if [[ $# -eq 0 && -n "${JULIET_BOOTSTRAP_ARGS:-}" ]]; then
  eval "set -- $JULIET_BOOTSTRAP_ARGS"
fi

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -y|--yes)
      YES_ALL="true"
      shift
      ;;
    -n|--no)
      NO_ALL="true"
      shift
      ;;
    --enable=*)
      IFS=',' read -ra ENABLED_STEPS <<< "${1#*=}"
      shift
      ;;
    --skip=*)
      IFS=',' read -ra SKIPPED_STEPS <<< "${1#*=}"
      shift
      ;;
    --ssh-email=*)
      SSH_EMAIL="${1#*=}"
      shift
      ;;
    -h|--help)
      show-help
      exit 0
      ;;
    *)
      warn "Unknown option: $1"
      show-help
      exit 1
      ;;
  esac
done

# Check if a step should run based on --enable and --skip flags
should-run-step() {
  local step="$1"

  # If --enable was used, only run if step is in the list
  if [[ ${#ENABLED_STEPS[@]} -gt 0 ]]; then
    [[ " ${ENABLED_STEPS[*]} " =~ " $step " ]] && return 0 || return 1
  fi

  # If --skip was used, skip if step is in the list
  if [[ " ${SKIPPED_STEPS[*]} " =~ " $step " ]]; then
    return 1
  fi

  return 0
}

# Determine whether to prompt or auto-answer based on flags
should-confirm() {
  local step="$1"
  local prompt="$2"

  # Step was explicitly enabled via --enable
  if [[ ${#ENABLED_STEPS[@]} -gt 0 ]] && [[ " ${ENABLED_STEPS[*]} " =~ " $step " ]]; then
    return 0
  fi

  # Global yes/no flags
  [[ "$YES_ALL" == "true" ]] && return 0
  [[ "$NO_ALL" == "true" ]] && return 1

  # Interactive prompt
  gum-confirm "$prompt"
}

# Category-level confirmation (combines should-run-step + should-confirm)
confirm-category() {
  local category="$1"
  local description="$2"

  if ! should-run-step "$category"; then
    rlog "Skipping $category install step(s)... (filtered)"
    return 1
  fi

  [[ "$YES_ALL" == "true" ]] && return 0

  if [[ "$NO_ALL" == "true" ]]; then
    rlog "Skipping $category install step(s)..."
    return 1
  fi

  if ! gum-confirm "$description"; then
    rlog "Skipping $category install step(s)..."
    return 1
  fi

  return 0
}

# OS Detection
is-fedora() {
  [ -f /etc/fedora-release ]
}

is-macos() {
  [[ "$OSTYPE" == "darwin"* ]]
}

setup-git() {
  rlog "Setting up git..."
  mkdir -p ~/.config/local
  [[ ! -f ~/.config/local/gitconfig ]] && cp ~/.config/Juliet/.gitconfig__local ~/.config/local/gitconfig
}

update-juliet() {
  rlog "Updating Juliet repository..."
  WORKDIR="$HOME/.config/Juliet"
  if [ -d "$WORKDIR" ]; then
    cd "$WORKDIR"

    if ! git diff --quiet; then
      warn "Warning: There are unstaged changes in ~/.config/Juliet. Skipping updating Juliet."
      cd - > /dev/null
      return
    fi


    DEFAULT_BRANCH=$(git remote show origin | grep 'HEAD branch' | cut -d' ' -f5)

    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    if [ "$CURRENT_BRANCH" = "$DEFAULT_BRANCH" ]; then
      git pull
    else
      warn "Warning: ~/.config/Juliet is not on the default branch. Current branch: $CURRENT_BRANCH"
      return
    fi

    cd - > /dev/null
  else
    log "Error: Juliet directory not found at $WORKDIR"
  fi
}


# Install Homebrew and wire it into PATH if it isn't already available.
ensure-brew() {
  if command -v brew &> /dev/null; then
    return
  fi

  rlog "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install.sh)"

  # Set up brew path based on OS
  if [[ -f /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    # Linux
    BREW_SHELLENV='eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"'
    if ! grep -q "linuxbrew" "$HOME/.bashrc" 2>/dev/null; then
      echo "$BREW_SHELLENV" >> "$HOME/.bashrc"
    fi
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  else
    # macOS
    echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >> "$HOME/.zprofile"
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi
}

# Install the tools bootstrap itself relies on before it uses them: stow (for
# symlinking dotfiles in core setup) and gum (for the confirmation prompts).
# The full package steps run later and are idempotent, so this early install is
# just to satisfy the ordering dependency.
ensure-bootstrap-deps() {
  rlog "Installing bootstrap prerequisites (stow, gum)..."
  if is-macos; then
    ensure-brew
    for tool in stow gum; do
      command -v "$tool" &> /dev/null || brew install "$tool"
    done
  elif is-fedora; then
    for tool in stow gum; do
      command -v "$tool" &> /dev/null || sudo dnf install -y "$tool"
    done
  fi
}

setup-brew() {
  rlog "Setting up Homebrew..."

  ensure-brew

  if ! command -v gum &> /dev/null; then
    brew install gum
  fi

  brew bundle --file ~/.config/Juliet/Brewfile
}

setup-cargo() {
  rlog "Setting up Cargo..."
  if ! command -v cargo &> /dev/null; then
    rustup-init
  fi
}

# A DNFfile entry may be satisfied by a differently-named package: Fedora 44
# ships node only as versioned streams (nodejs -> nodejs22 via a virtual
# provide), kubernetes-client -> kubernetes1.36-client, and dnf resolves
# deno -> deno-bin through /usr/bin/deno binary provides. Checking only
# `rpm -q <name>` misses all of these, so those entries got "retried"
# (and reported failed on any transient dnf error) on every single run.
dnf-satisfied() {
  rpm -q "$1" &> /dev/null && return 0
  rpm -q --whatprovides "$1" &> /dev/null && return 0
  # Binary/file provides need dnf's resolver; --assumeno exits 0 only when
  # the spec is already satisfied. The cache is fresh from the transaction
  # that just ran, so --cacheonly keeps this fast and offline.
  dnf --cacheonly install --assumeno "$1" &> /dev/null
}

setup-dnf() {
  log "Setting up DNF packages..."

  if ! command -v gum &> /dev/null; then
    sudo dnf install -y gum
  fi

  DNFFILE="$HOME/.config/Juliet/DNFfile"
  if [[ ! -f "$DNFFILE" ]]; then
    warn "DNFfile not found at $DNFFILE"
    return
  fi

  # Enable RPM Fusion (free + nonfree) first: some DNFfile packages (e.g.
  # steam) only exist there and would otherwise be silently skipped by
  # --skip-unavailable.
  if ! rpm -q rpmfusion-free-release &> /dev/null || ! rpm -q rpmfusion-nonfree-release &> /dev/null; then
    log "Enabling RPM Fusion repositories..."
    sudo dnf install -y \
      "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
      "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm"
  fi

  # Enable COPR repos first
  while IFS= read -r line || [[ -n "$line" ]]; do
    # Skip empty lines and comments
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    # Handle COPR repos
    if [[ "$line" =~ ^copr[[:space:]]+ ]]; then
      repo="${line#copr }"
      if ! dnf copr list 2>/dev/null | grep -q "$repo"; then
        log "Enabling COPR: $repo"
        sudo dnf copr enable -y "$repo"
      fi
    fi
  done < "$DNFFILE"

  # Collect packages
  packages=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    # Skip empty lines, comments, and copr lines
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# || "$line" =~ ^copr[[:space:]]+ ]] && continue
    packages+=("$line")
  done < "$DNFFILE"

  # Install packages
  if [[ ${#packages[@]} -gt 0 ]]; then
    log "Installing ${#packages[@]} packages..."
    # --skip-unavailable/--skip-broken keep one bad package (e.g. steam
    # without RPM Fusion) from aborting the whole transaction.
    sudo dnf install -y --skip-unavailable --skip-broken "${packages[@]}"

    # Retry anything still missing individually so each failure surfaces its
    # own error instead of being silently skipped.
    failed=()
    for pkg in "${packages[@]}"; do
      dnf-satisfied "$pkg" && continue
      log "Retrying $pkg individually..."
      sudo dnf install -y "$pkg" || failed+=("$pkg")
    done
    if [[ ${#failed[@]} -gt 0 ]]; then
      warn "Failed to install: ${failed[*]}"
    fi
  fi
}

setup-flatpak() {
  log "Setting up Flatpak packages..."

  FLATPAKFILE="$HOME/.config/Juliet/Flatpakfile"
  if [[ ! -f "$FLATPAKFILE" ]]; then
    warn "Flatpakfile not found at $FLATPAKFILE"
    return
  fi

  # Add remotes first
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    if [[ "$line" =~ ^remote[[:space:]]+ ]]; then
      read -r _ name url <<< "$line"
      log "Adding Flatpak remote: $name"
      flatpak remote-add --if-not-exists "$name" "$url"
    fi
  done < "$FLATPAKFILE"

  # Install apps
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# || "$line" =~ ^remote[[:space:]]+ ]] && continue
    log "Installing Flatpak: $line"
    flatpak install -y flathub "$line"
  done < "$FLATPAKFILE"
}

symlink-dotfiles() {
  log "Symlinking dotfiles..."
  mkdir ~/.claude 2>/dev/null || true
  stow --target=$HOME --dir=$HOME/.config/Juliet/symlinked home
  stow --target=$HOME/.config --dir=$HOME/.config/Juliet/symlinked config
  stow --target=$HOME/.local/state --dir=$HOME/.config/Juliet/symlinked local-state
}

setup-ssh() {
  log "Setting up SSH..."

  if [[ ! -d $HOME/.ssh ]]; then
    mkdir $HOME/.ssh
    chmod 700 $HOME/.ssh
  fi

  # Three keys: a general-purpose one, plus dedicated GitHub auth and signing
  # keys. The tracked gitconfig signs commits over SSH, and the tracked
  # ~/.config/ssh/github.conf pins the auth key for github.com.
  local missing=()
  local key
  for key in id_ed25519 github_auth github_signing; do
    [[ -f $HOME/.ssh/$key ]] || missing+=("$key")
  done

  local email="${SSH_EMAIL:-}"
  if [[ ${#missing[@]} -gt 0 && -z "$email" ]]; then
    email=$(gum input --prompt "What is your email for your ssh keys? " --placeholder "your_email@example.com")
    [[ $? -ne 0 || -z "$email" ]] && on-interrupt
  fi

  for key in "${missing[@]}"; do
    local comment="$email"
    case "$key" in
      github_auth) comment="$email (github auth)" ;;
      github_signing) comment="$email (github signing)" ;;
    esac
    ssh-keygen -t ed25519 -C "$comment" -f "$HOME/.ssh/$key"
  done

  # allowed_signers maps git author emails to the signing key so git can
  # verify SSH-signed commits locally (git log --show-signature). The tracked
  # gitconfig points gpg.ssh.allowedSignersFile here.
  local signers="$HOME/.ssh/allowed_signers"
  local signing_pub
  signing_pub=$(cut -d' ' -f1-2 "$HOME/.ssh/github_signing.pub")
  local git_email
  git_email=$(git config user.email 2>/dev/null || true)
  for signer_email in "$git_email" "$email"; do
    [[ -z "$signer_email" ]] && continue
    if ! grep -qsF "$signer_email $signing_pub" "$signers"; then
      echo "$signer_email $signing_pub" >> "$signers"
    fi
  done

  # ~/.ssh can't be stowed (generated keys would land inside the repo), so the
  # tracked GitHub host config lives at ~/.config/ssh/github.conf and gets
  # wired in with an Include at the top of ~/.ssh/config.
  local sshconf="$HOME/.ssh/config"
  local include_line="Include ~/.config/ssh/github.conf"
  if ! grep -qsxF "$include_line" "$sshconf"; then
    log "Wiring tracked GitHub ssh config into ~/.ssh/config..."
    {
      echo "$include_line"
      [[ -f "$sshconf" ]] && cat "$sshconf"
    } > "$sshconf.juliet-tmp"
    mv "$sshconf.juliet-tmp" "$sshconf"
    chmod 600 "$sshconf"
  fi

  # Upload freshly generated GitHub keys via gh when possible. gh needs the
  # admin:public_key / admin:ssh_signing_key scopes, which the default login
  # doesn't grant — fall back to instructions if the add is rejected.
  if [[ ${#missing[@]} -gt 0 ]]; then
    local uploaded=true
    if command -v gh &> /dev/null && gh auth status &> /dev/null; then
      for key in "${missing[@]}"; do
        case "$key" in
          github_auth)
            gh ssh-key add "$HOME/.ssh/github_auth.pub" --type authentication --title "$(hostname) auth" || uploaded=false
            ;;
          github_signing)
            gh ssh-key add "$HOME/.ssh/github_signing.pub" --type signing --title "$(hostname) signing" || uploaded=false
            ;;
        esac
      done
    else
      uploaded=false
    fi
    if [[ "$uploaded" == "false" ]]; then
      warn "Couldn't upload new SSH keys to GitHub automatically. Run:"
      warn "  gh auth refresh -h github.com -s admin:public_key -s admin:ssh_signing_key"
      warn "  gh ssh-key add ~/.ssh/github_auth.pub --type authentication --title \"$(hostname) auth\""
      warn "  gh ssh-key add ~/.ssh/github_signing.pub --type signing --title \"$(hostname) signing\""
    fi
  fi
}

setup-fzf() {
  if ! command -v fzf &> /dev/null; then
    log "Installing fzf..."
    /opt/homebrew/opt/fzf/install
  fi
}

setup-tmux-plugins() {
  # tpm (tmux plugin manager) bootstraps the plugins declared in the tracked
  # .tmux.conf; nothing installs it besides this clone.
  if [[ ! -d "$HOME/.tmux/plugins/tpm" ]]; then
    rlog "Installing tpm (tmux plugin manager)..."
    git clone --depth=1 https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
  fi
}

setup-fish() {
  mkdir -p ~/.config/fish

  FISH_PATH="$(command -v fish)"
  if [[ -z "$FISH_PATH" ]]; then
    warn "fish not found, skipping fish setup"
    return
  fi
  log "Setting up fish..."

  if ! grep -q "$FISH_PATH" /etc/shells 2>/dev/null; then
    log "Adding $FISH_PATH to /etc/shells..."
    sudo bash -c "echo '$FISH_PATH' >> /etc/shells"
  fi

  if [[ "$SHELL" != "$FISH_PATH" ]]; then
    log "Setting fish to default shell..."
    chsh -s "$FISH_PATH" "$(whoami)"
  fi
}

setup-gpg() {
  if [[ ! -d $HOME/.gnupg ]]; then
    log "Setting up GPG..."
    mkdir ~/.gnupg
    touch ~/.gnupg/gpg-agent.conf
    echo "pinentry-program /usr/local/bin/pinentry-mac" >> ~/.gnupg/gpg-agent.conf
  fi
}

setup-cyberduck() {
  # macOS-only. Cyberduck offers every identity in the SSH agent, which trips
  # strict servers' MaxAuthTries (and fail2ban) before the right key is tried.
  # Tell it to ignore the agent and use only the key set per-bookmark instead.
  if ! is-macos; then
    return
  fi

  if [[ ! -d "/Applications/Cyberduck.app" && ! -d "$HOME/Applications/Cyberduck.app" ]]; then
    return
  fi

  log "Configuring Cyberduck (ignore SSH agent, use per-bookmark key)..."
  defaults write ch.sudo.cyberduck ssh.authentication.agent.enable -bool false
}

setup-rust() {
  rlog "Setting up Rust dependencies..."
  if ! command -v stylua &> /dev/null; then
    cargo install stylua
  fi

  if is-macos && ! command -v silicon &> /dev/null; then
    cargo install silicon
  fi

  # tabiew (tw, used by the cq alias); macOS gets it from the Brewfile
  if is-fedora && ! command -v tw &> /dev/null; then
    cargo install tabiew
  fi
}

setup-python() {
  rlog "Setting up Python..."
  if ! command -v poetry &> /dev/null; then
    curl -sSL https://install.python-poetry.org | python3 -
  fi

  # sqlfluff (neoformat's SQL formatter) has no Fedora dnf package; macOS gets
  # it from the Brewfile
  if is-fedora && ! command -v sqlfluff &> /dev/null; then
    pip install --user sqlfluff
  fi

  # pipenv (the pv alias) was dropped from Fedora's repos entirely; macOS gets
  # it from the Brewfile
  if is-fedora && ! command -v pipenv &> /dev/null; then
    pip install --user pipenv
  fi
}

setup-node-tools() {
  rlog "Setting up Node tools..."
  # prettier/eslint (neoformat/nvim-lint) have no Fedora dnf packages; macOS
  # gets them from the Brewfile
  if is-fedora; then
    for tool in prettier eslint; do
      if ! command -v "$tool" &> /dev/null; then
        sudo npm install -g "$tool"
      fi
    done
  fi
}

setup-nodenv() {
  # macOS gets nodenv from the Brewfile; Fedora has no dnf package, so use the
  # official installer (clones nodenv + node-build into ~/.nodenv).
  if command -v nodenv &> /dev/null || [[ -d "$HOME/.nodenv/bin" ]]; then
    return
  fi
  rlog "Installing nodenv..."
  curl -fsSL https://github.com/nodenv/nodenv-installer/raw/HEAD/bin/nodenv-installer | bash
}

setup-sddm() {
  if ! is-fedora; then
    return
  fi

  if ! command -v sddm &> /dev/null; then
    return
  fi
  log "Setting up SDDM theme..."

  THEME_SRC="$HOME/.config/Juliet/etc/sddm-themes/juliet"
  THEME_DEST="/usr/share/sddm/themes/juliet"

  if [[ ! -d "$THEME_SRC" ]]; then
    return
  fi

  # Always copy/update theme to system directory
  log "Installing Juliet SDDM theme..."
  sudo rm -rf "$THEME_DEST"
  sudo cp -r "$THEME_SRC" "$THEME_DEST"
  sudo cp "$HOME/.config/Juliet/etc/wallpaper/my-neighbor-totoro-sunflowers.png" "$THEME_DEST/background.png"
  sudo chmod -R 755 "$THEME_DEST"
  sudo find "$THEME_DEST" -type f -exec chmod 644 {} \;

  # Set theme in SDDM config
  SDDM_CONF="/etc/sddm.conf.d/juliet.conf"
  if [[ ! -f "$SDDM_CONF" ]]; then
    log "Configuring SDDM to use Juliet theme..."
    sudo tee "$SDDM_CONF" > /dev/null << 'EOF'
[Theme]
Current=juliet
EOF
  fi
}

setup-claude-code() {
  rlog "Setting up Claude Code..."
  if ! command -v claude &> /dev/null; then
    curl -fsSL https://claude.ai/install.sh | bash
  fi

  # Configure git to authenticate GitHub over HTTPS via the gh CLI. Claude Code
  # clones marketplaces/plugins over HTTPS, so private ones (e.g. the
  # avegancafe-marketplace referenced in settings.json) fail to clone without an
  # HTTPS credential helper. We write it to the machine-local gitconfig (included
  # by the tracked ~/.gitconfig) rather than running `gh auth setup-git`, which
  # would bake a machine-specific absolute gh path into the tracked dotfile. The
  # `!gh ...` form resolves gh from PATH, so it stays portable across macOS/Fedora.
  if command -v gh &> /dev/null; then
    if gh auth status &> /dev/null; then
      log "Configuring gh as the git credential helper for GitHub (HTTPS access to private repos)..."
      mkdir -p "$HOME/.config/local"
      git config --file "$HOME/.config/local/gitconfig" credential."https://github.com".helper "!gh auth git-credential"
      git config --file "$HOME/.config/local/gitconfig" credential."https://gist.github.com".helper "!gh auth git-credential"
    else
      warn "gh is installed but not authenticated. Run 'gh auth login', then re-run this step, to enable HTTPS cloning of private repos (needed for private plugin marketplaces)."
    fi
  else
    warn "gh not found; skipping git credential-helper setup. Private plugin marketplaces won't clone over HTTPS until gh is installed and authenticated."
  fi

  # Define marketplaces to add
  # Format: "name:id" pairs (bash 3.2 compatible)
  marketplaces=(
    "superpowers-marketplace:obra/superpowers-marketplace"
    "claude-plugins-official:anthropics/claude-plugins-official"
  )

  # Add marketplaces if not already registered
  for marketplace_pair in "${marketplaces[@]}"; do
    marketplace_name="${marketplace_pair%%:*}"
    marketplace_id="${marketplace_pair#*:}"
    if ! claude plugin marketplace list 2>/dev/null | grep -Fq "$marketplace_name"; then
      log "Adding $marketplace_name marketplace..."
      claude plugin marketplace add "$marketplace_id" 2>/dev/null || true
    fi
  done

  # Define plugins to install
  plugins=(
    "superpowers@superpowers-marketplace"
    "frontend-design@claude-plugins-official"
    "context7@claude-plugins-official"
    "sentry@claude-plugins-official"
    "linear@claude-plugins-official"
    "playwright@claude-plugins-official"
  )

  # Install plugins if not already installed
  for plugin in "${plugins[@]}"; do
    if ! claude plugin list 2>/dev/null | grep -Fq "$plugin"; then
      log "Installing $plugin..."
      claude plugin install "$plugin" || warn "Failed to install $plugin"
    fi
  done
}

# =============================================================================
# Category Runner Functions
# =============================================================================

run-packages() {
  confirm-category "packages" "Install system packages? (neovim, bat, ripgrep, fzf, gh, starship, ghostty...)" || return
  if is-macos; then
    setup-brew
  elif is-fedora; then
    setup-dnf
    setup-flatpak
  fi
}

run-dev() {
  confirm-category "dev" "Install dev tools? (rust/cargo, stylua, poetry, nodenv, prettier/eslint)" || return
  setup-cargo
  setup-rust
  setup-python
  setup-nodenv
  setup-node-tools
}

run-shell() {
  confirm-category "shell" "Configure shell? (fish as default, fzf keybindings, tmux plugins)" || return
  setup-fish
  setup-fzf
  setup-tmux-plugins
}

run-security() {
  confirm-category "security" "Set up security? (SSH key, GPG agent)" || return
  setup-ssh
  setup-gpg
  setup-cyberduck
}

run-desktop() {
  # Only show on Linux with relevant tools. Noctalia (the niri shell) needs no
  # setup step here: it's installed via the DNFfile and started by
  # spawn-at-startup in the niri config.
  if ! is-fedora; then return; fi
  if ! command -v sddm &> /dev/null; then return; fi

  confirm-category "desktop" "Configure desktop? (sddm theme)" || return
  setup-sddm
}

run-claude() {
  confirm-category "claude" "Set up Claude Code? (CLI, superpowers, context7, LSP plugins)" || return
  setup-claude-code
}

