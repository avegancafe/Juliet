#!/usr/bin/env bash
# fixme — hand this terminal's scrollback to a new Claude session that looks
# for errors/issues and asks which ones to fix.
#
# Usage: fixme [--lines N] [--scrollback FILE]... [note...]
#   --lines N           capture the last N lines of scrollback (default 5000)
#   --scrollback FILE   use FILE as the scrollback instead of capturing it;
#                       repeat to join files in order (empty values are skipped)
#   note                free-text hint passed along to Claude, e.g. `fixme the brew step failed`
#
# Works in cmux and in Ghostty on macOS. In Ghostty on Linux, press
# super+ctrl+shift+f at a prompt instead (it runs fixme with this pane's
# scrollback; that also works on macOS). Claude opens in a split to the right, except in
# Ghostty on Linux, where it opens in a new window (niri puts it in the next
# column) since Ghostty's GTK build can't split from a script.
set -euo pipefail

lines=5000
scrollback=()
note=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --lines) lines="${2:?--lines needs a number}"; shift 2 ;;
    --lines=*) lines="${1#*=}"; shift ;;
    --scrollback) scrollback+=("${2:?--scrollback needs a file}"); shift 2 ;;
    --scrollback=) shift ;;
    --scrollback=*) scrollback+=("${1#*=}"); shift ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) note+=("$1"); shift ;;
  esac
done

in_cmux() { [[ -n "${CMUX_SURFACE_ID:-}" ]] && command -v cmux >/dev/null; }
in_ghostty() { [[ "${TERM_PROGRAM:-}" == ghostty ]]; }

# Pressing super+ctrl+shift+f at a prompt types `fixme --scrollback=<file> `
# before whatever note was on the line, so a typed `fixme the brew step failed`
# arrives with a note starting with "fixme".
if [[ "${note[0]:-}" == fixme ]]; then
  note=(${note[@]+"${note[@]:1}"})
fi

# Ghostty has no command a shell can run to read a pane's scrollback, but its
# write_screen_file action (scrollback + screen) can paste the dump file's path
# into the pane, and while we run, that input is ours. On macOS, AppleScript
# runs the same actions as the super+ctrl+shift+f keybind on this exact pane;
# we turn off echo and read back the `fixme --scrollback=<file>` line it types.
# Linux Ghostty has no such API (its D-Bus/CLI IPC can only open windows), and
# faking the keypress could land in whatever window gets focus, so there you
# press super+ctrl+shift+f yourself.
read_dump_path() {
  local line paste_start=$'\e[200~' paste_end=$'\e[201~'
  while IFS= read -r -t 2 line </dev/tty; do
    # Drop bracketed-paste markers in case the shell left that mode on.
    line="${line//"$paste_start"/}"
    line="${line//"$paste_end"/}"
    if [[ "$line" == *"fixme --scrollback="* ]]; then
      line="${line#*fixme --scrollback=}"
      printf '%s\n' "${line%%[[:space:]]*}"
      return 0
    fi
  done
  return 1
}

ghostty_capture_macos() {
  local tty_state file=""
  tty_state="$(stty -g </dev/tty)"
  stty -echo </dev/tty
  # Ghostty 1.3+ AppleScript runs the actions on the focused terminal (this one).
  osascript >/dev/null <<'APPLESCRIPT'
tell application "Ghostty"
  set t to focused terminal of selected tab of front window
  perform action "text:\\x01fixme --scrollback=" on t
  perform action "write_screen_file:paste" on t
  perform action "text:\\x20\\r" on t
end tell
APPLESCRIPT
  file="$(read_dump_path)" || true
  stty "$tty_state" </dev/tty

  if [[ -z "$file" ]]; then
    echo "fixme: Ghostty didn't hand over the scrollback (is AppleScript allowed for Ghostty in System Settings → Privacy & Security → Automation?)" >&2
    exit 1
  fi
  scrollback+=("$file")
}

if [[ ${#scrollback[@]} -eq 0 ]] && ! in_cmux; then
  if in_ghostty && [[ "$(uname -s)" != Darwin ]]; then
    echo "fixme: in Ghostty on Linux, press super+ctrl+shift+f at a shell prompt instead (type an optional note first)." >&2
    echo "       (If nothing happens, reload Ghostty's config: ctrl+shift+,)" >&2
    exit 1
  elif in_ghostty && [[ -t 0 ]]; then
    ghostty_capture_macos
  else
    echo "fixme: must be run inside cmux or Ghostty" >&2
    exit 1
  fi
fi
for f in ${scrollback[@]+"${scrollback[@]}"}; do
  if [[ ! -r "$f" ]]; then
    echo "fixme: can't read scrollback file: $f" >&2
    exit 1
  fi
done

dir="${TMPDIR:-/tmp}/fixme"
mkdir -p "$dir"
stamp="$(date +%Y%m%d-%H%M%S)"
capture="$dir/$stamp-scrollback.txt"
prompt_file="$dir/$stamp-prompt.md"

if [[ ${#scrollback[@]} -gt 0 ]]; then
  cat "${scrollback[@]}" | tail -n "$lines" >"$capture"
else
  cmux read-screen --surface "$CMUX_SURFACE_ID" --lines "$lines" >"$capture"
fi

prompt="Read the terminal session capture at $capture (the last $lines lines of scrollback from the pane I was just working in; my working directory was $PWD).

Examine it for errors, warnings, failed steps, and inconsistencies (things that contradict each other or look silently wrong). Ignore the final \`fixme\` invocation itself. Investigate enough to explain each finding's likely cause.

Then use the AskUserQuestion tool (multiSelect) to ask me which findings to fix - one option per finding, with a short description of the likely cause and fix.

For the ones I pick:
- If this directory has no .beads/ yet, ask me (AskUserQuestion) whether to run \`bd init\` or skip tracking.
- File one bead per chosen issue (per my CLAUDE.md conventions), then fix them.
- When the selected fixes are done, commit them (focused messages referencing the beads) and push.
You're in plan mode: present the beads-to-file and fixes as a plan for approval before doing either."

if [[ ${#note[@]} -gt 0 ]]; then
  prompt+="

User note: ${note[*]}"
fi

printf '%s\n' "$prompt" >"$prompt_file"

# $cmd is run by the new pane's interactive shell (fish), so keep it one line
# of plain single-quoted words that fish and POSIX shells parse alike.
sq() { local esc="'\\''"; printf "'%s'" "${1//\'/$esc}"; }
cmd="cd $(sq "$PWD") && claude --permission-mode plan $(sq "Read $prompt_file and follow the instructions in it.")"

if in_cmux; then
  cmux new-split right --surface "$CMUX_SURFACE_ID" --focus true --command "$cmd" >/dev/null
elif [[ "$(uname -s)" == Darwin ]]; then
  # Ghostty 1.3+ AppleScript: split the focused terminal (the one the keybind
  # fired in) and type $cmd into the new split's shell, like cmux --command.
  osascript - "$PWD" "$cmd" >/dev/null <<'APPLESCRIPT'
on run argv
  tell application "Ghostty"
    set cfg to {initial working directory:(item 1 of argv), initial input:((item 2 of argv) & linefeed)}
    set t to focused terminal of selected tab of front window
    focus (split t direction right with configuration cfg)
  end tell
end run
APPLESCRIPT
else
  # Ghostty GTK has no scriptable splits, so open a new window via D-Bus. Run
  # $cmd in a login+interactive shell so PATH and secrets match a normal tab,
  # then drop to a shell when Claude exits.
  shell="${SHELL:-/bin/bash}"
  ghostty +new-window --working-directory="$PWD" -e "$shell" -lic "$cmd; exec $(sq "$shell") -l" >/dev/null
fi
echo "fixme: captured $(wc -l <"$capture" | tr -d ' ') lines → $capture"
