# Machine-local git overrides. juliet-bootstrap copies this to
# ~/.config/local/gitconfig, which the tracked ~/.gitconfig includes. Values
# here override the tracked defaults (including the SSH signing key), so keep
# only genuinely machine-specific settings.
[user]
	email = kylelholzinger@gmail.com
	# The tracked ~/.gitconfig signs commits over SSH with ~/.ssh/id_ed25519.
	# juliet-bootstrap also generates a dedicated ~/.ssh/github_signing key
	# (uploaded to GitHub as a signing key); uncomment to sign with it instead:
	# signingkey = ~/.ssh/github_signing.pub
