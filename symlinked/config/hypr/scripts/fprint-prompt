#!/bin/sh
# Text for hyprlock's fingerprint label. hyprlock substitutes $FPRINTPROMPT
# before running the label's cmd[], so $1 is the reader's live prompt.
#
# - "Reading" (auth:fingerprint:present_message, a finger is on the sensor)
#   gets dots cycling 1 -> 2 -> 3, so a touch visibly registers.
# - Empty means hyprlock hasn't armed the reader yet (e.g. the first ~2s after
#   waking from suspend); touches are ignored then, so say it's still waking.
# - Anything else (ready, retry, no-match) passes through unchanged.
prompt=$1
dots() {
    n=$(( $(date +%s%N) / 400000000 % 3 + 1 ))
    printf '%.*s' "$n" '...'
}
case $prompt in
    Reading) printf 'Reading%s\n' "$(dots)" ;;
    '') printf 'Waking fingerprint reader%s\n' "$(dots)" ;;
    *) printf '%s\n' "$prompt" ;;
esac
