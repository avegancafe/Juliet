{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "plugin": [
    "j2-eng@git+https://github.com/j2-health/j2-eng-plugin.git#cb30c1e43ebf4ff0f2f0af0dca93ba8c3c20e86a",
    "j2-presentations@git+https://github.com/j2-health/j2-presentations-plugin.git#0c65b1a8d0259999664ddb6a11d31149604425b3"
  ],
  "mcp": {
    "launchdarkly": {
      "type": "remote",
      "url": "https://mcp.launchdarkly.com/mcp/launchdarkly",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--isolated"
      ],
      "enabled": true
    }
  },
  "lsp": {
    "pylsp": {
      "command": [
        "uv",
        "run",
        "--directory",
        ".",
        "--with",
        "python-lsp-server",
        "--with",
        "pylsp-mypy",
        "pylsp"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mts",
        ".cts",
        ".mjs",
        ".cjs"
      ]
    }
  }
}
