theme = bamboo

font-family = Iosevka Nerd Font Mono
font-size = 18
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

keybind = global:ctrl+shift+g=toggle_quick_terminal
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
quick-terminal-animation-duration = 0
quick-terminal-size = 100%
macos-titlebar-style = tabs
keybind = shift+enter=text:\n

# fixme (Juliet bin/fixme): dump this pane's scrollback + screen to a file and
# type `fixme --scrollback=<file> ` at the start of the line (\x01), then run it.
# Press it at a shell prompt, after typing an optional note. (On macOS, typing
# `fixme` also works: it runs these same actions via AppleScript. Keep in sync
# with ghostty_capture_macos in bin/fixme.)
keybind = super+ctrl+shift+f=text:\x01fixme --scrollback=
keybind = chain=write_screen_file:paste
keybind = chain=text:\x20\r

config-file = ?../local/ghostty/config
