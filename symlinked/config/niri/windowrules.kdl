// Per-app workspace assignments (originally created via DMS, now hand-managed)

window-rule {
    match app-id="^steam$"
    open-on-workspace "gaming"
}

window-rule {
    match app-id="^com.mitchellh.ghostty$"
    open-on-workspace "coding"
}

// Claude Duet: a Chromium app window that juliet-kyle autostarts at login.
// Sits next to Ghostty. No-op on machines without it.
window-rule {
    match app-id="^chrome-claude\\.ai__duet-Default$"
    open-on-workspace "coding"
}

window-rule {
    match app-id="^org.mozilla.firefox$"
    open-on-workspace "work"
}

// At login, Ghostty and Duet split the coding workspace half and half.
// at-startup only matches during the first 60s after niri starts, so
// windows opened later keep the default width.
window-rule {
    match app-id="^com.mitchellh.ghostty$" at-startup=true
    match app-id="^chrome-claude\\.ai__duet-Default$" at-startup=true
    default-column-width { proportion 0.5; }
}
